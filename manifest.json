{
  "manifest_version": 3,
  "name": "SeLoger - Temps de trajet",
  "version": "0.1.0",
  "description": "Affiche le temps de trajet en voiture depuis votre adresse pour un bien consulté sur SeLoger.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "*://*.seloger.com/*",
    "https://api.openrouteservice.org/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Temps de trajet SeLoger",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.seloger.com/*"],
      "js": ["src/inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://*.seloger.com/*"],
      "js": ["src/content.js"],
      "run_at": "document_idle"
    }
  ]
}

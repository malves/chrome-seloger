<%
  const specs = [
    ["Type de bien", fmt.propertyTypeLabel(listing.property_type)],
    ["Transaction", fmt.transactionLabel(listing.transaction_type)],
    ["Prix", listing.price !== null ? fmt.euro(listing.price) : null],
    ["Prix au m²", listing.price_per_m2 ? fmt.euro(listing.price_per_m2) + " / m²" : null],
    ["Surface habitable", listing.surface ? fmt.surface(listing.surface) : null],
    ["Surface du terrain", listing.land_surface ? fmt.surface(listing.land_surface) : null],
    ["Pièces", listing.rooms || null],
    ["Chambres", listing.bedrooms || null],
    ["Étage", listing.floor !== null && listing.floor !== undefined ? listing.floor : null],
    ["Année de construction", listing.year_built || null],
    ["État", listing.property_condition],
    ["Chauffage", listing.heating_system],
    ["Source d'énergie", listing.energy_source],
    ["Construction", listing.is_new_build ? "Neuf" : null],
    ["Commune", listing.city],
    ["Code postal", listing.postal_code],
    ["Code INSEE", typeof postalInseeCode !== "undefined" ? postalInseeCode : null],
    ["Agence", listing.agency && listing.agency.name ? listing.agency.name : null],
    ["Téléphone", listing.agency && listing.agency.phone ? listing.agency.phone : null],
    [
      "Honoraires d'agence",
      listing.agency && listing.agency.fees_percent
        ? listing.agency.fees_percent + " %" + (listing.agency.fees_included ? " (inclus)" : "")
        : null,
    ],
    ["Identifiant source", listing.source_id],
  ].filter(([, value]) => value !== null && value !== undefined && value !== "");
  const hasEnergyData = listing.dpe || listing.ges;
%>

<div class="detail">
  <!-- 1. En-tête + barre de suivi (swapés ensemble quand le statut change) -->
  <%- include("partials/listing-lead", { listing: listing, projects: projects }) %>

  <!-- 2. Localisation précise (panneau + modale de saisie) -->
  <%- include("partials/listing-location-block", { listing: listing, userAddressMapsHref: userAddressMapsHref }) %>

  <!-- 3. Galerie (carrousel : flèches, compteur, miniatures, clavier) -->
  <% if (photos.length) { %>
    <section class="panel">
      <div class="panel__head">
        <div>
          <p class="panel__eyebrow">Photos</p>
          <h2 class="panel__title"><%= photos.length %> photo<%= photos.length > 1 ? 's' : '' %></h2>
        </div>
        <span class="card__foot-note">Images servies par <%= fmt.sourceLabel(listing.source) %></span>
      </div>

      <%
        // Badges « Projection », « Plan »… issus de l'analyse des photos.
        var galleryBadges = (typeof photoAnalysis !== "undefined" && photoAnalysis && photoAnalysis.galleryBadges) || {};
        var galleryBadgeLabels = (typeof photoLabels !== "undefined" && photoLabels.GALLERY_BADGES) || {};
        function galleryBadgeFor(index) {
          var cls = galleryBadges[index];
          return cls && galleryBadgeLabels[cls] ? { cls: cls, label: galleryBadgeLabels[cls] } : null;
        }
      %>
      <div class="carousel" data-carousel>
        <div class="carousel__stage">
          <div class="carousel__viewport" tabindex="0" aria-roledescription="carrousel"
               aria-label="Photos de l'annonce">
            <div class="carousel__track" data-carousel-track>
              <% photos.forEach(function (url, index) { var badge = galleryBadgeFor(index); %>
                <div class="carousel__slide<%= badge ? ' carousel__slide--flagged' : '' %>" role="group" aria-roledescription="diapositive"
                     aria-label="Photo <%= index + 1 %> sur <%= photos.length %><%= badge ? ' — ' + badge.label : '' %>">
                  <img
                    src="<%= url %>"
                    alt="Photo <%= index + 1 %> de l'annonce"
                    loading="<%= index === 0 ? 'eager' : 'lazy' %>"
                    referrerpolicy="no-referrer"
                  />
                  <% if (badge) { %>
                    <span class="carousel__flag carousel__flag--<%= badge.cls %>"><%= badge.label %></span>
                  <% } %>
                </div>
              <% }); %>
            </div>
          </div>

          <% if (photos.length > 1) { %>
            <button type="button" class="carousel__nav carousel__nav--prev"
                    data-carousel-prev aria-label="Photo précédente">‹</button>
            <button type="button" class="carousel__nav carousel__nav--next"
                    data-carousel-next aria-label="Photo suivante">›</button>
            <div class="carousel__counter" data-carousel-counter aria-live="polite">
              1 / <%= photos.length %>
            </div>
          <% } %>
        </div>

        <% if (photos.length > 1) { %>
          <div class="carousel__thumbs" data-carousel-thumbs>
            <% photos.forEach(function (url, index) { var badge = galleryBadgeFor(index); %>
              <button type="button"
                      class="carousel__thumb<%= index === 0 ? ' is-active' : '' %><%= badge ? ' carousel__thumb--flagged' : '' %>"
                      data-carousel-thumb="<%= index %>"
                      aria-label="Aller à la photo <%= index + 1 %><%= badge ? ' (' + badge.label + ')' : '' %>">
                <img src="<%= url %>" alt="" loading="lazy" referrerpolicy="no-referrer" />
                <% if (badge) { %><span class="carousel__thumb-flag" aria-hidden="true"><%= badge.label %></span><% } %>
              </button>
            <% }); %>
          </div>
        <% } %>
      </div>
    </section>
  <% } %>

  <!-- 4. Caractéristiques -->
  <section class="panel">
    <div class="panel__head">
      <div>
        <p class="panel__eyebrow">Le bien</p>
        <h2 class="panel__title">Caractéristiques</h2>
      </div>
    </div>

    <% if (specs.length) { %>
      <div class="kv kv--grid">
        <% specs.forEach(function ([label, value]) { %>
          <div class="kv__row">
            <span class="kv__key"><%= label %></span>
            <span class="kv__value"><%= value %></span>
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <p class="field__hint">
        Aucune caractéristique n'a été extraite pour cette annonce.
      </p>
    <% } %>

    <% if (listing.description) { %>
      <% const descriptionPreviewLength = 160; %>
      <% const descriptionLong = listing.description.length > descriptionPreviewLength; %>
      <div class="listing-description" data-listing-description>
        <h2 class="panel__title listing-description__title" id="listing-description-title">
          Description
        </h2>
        <div class="listing-description__card">
          <div
            id="listing-description-body"
            class="listing-description__body"
            role="region"
            aria-labelledby="listing-description-title"
          >
            <div
              class="listing-description__excerpt<%= descriptionLong ? ' listing-description__excerpt--truncated' : '' %>"
              data-listing-description-excerpt
              <%= descriptionLong ? 'data-listing-description-clamp="2"' : '' %>
            >
              <div class="description listing-description__text"><%= listing.description %></div>
              <% if (descriptionLong) { %>
                <button
                  type="button"
                  class="listing-description__toggle"
                  data-listing-description-toggle
                  aria-expanded="false"
                  aria-controls="listing-description-body"
                >
                  <span class="listing-description__toggle-label">Voir plus</span>
                </button>
              <% } %>
            </div>
          </div>
        </div>
      </div>
    <% } %>

    <% if (hasEnergyData) { %>
      <div class="listing-description">
        <h2 class="panel__title listing-description__title">Performance énergétique</h2>
        <%- include("partials/energy-performance", { listing: listing }) %>
      </div>
    <% } %>
  </section>

  <!-- 4a. Travaux : pièces et état (modale), analyse des photos -->
  <% var worksHasPhotos = photos.length; %>
  <%- include("partials/works-icons") %>
  <section
    class="panel works<%= worksHasPhotos ? '' : ' works--dpe-only' %>"
    id="listing-works"
    aria-labelledby="listing-works-title"
  >
    <div class="panel__head works__head">
      <div class="works__heading">
        <div>
          <p class="panel__eyebrow">Analyse technique du bien par l'IA</p>
          <h2 class="panel__title" id="listing-works-title">État général</h2>
        </div>
      </div>
      <% if (photos.length && typeof photoAnalysis !== "undefined" && photoAnalysis) { %>
        <%- include("partials/listing-works-head-aside", {
          listing: listing,
          photoAnalysis: photoAnalysis,
          photoLabels: photoLabels,
          worksHasPhotos: worksHasPhotos,
        }) %>
      <% } %>
    </div>

    <% if (photos.length && typeof photoAnalysis !== "undefined" && photoAnalysis) { %>
      <%- include("partials/listing-photo-analysis", {
        listing: listing,
        photos: photos,
        photoAnalysis: photoAnalysis,
        photoLabels: photoLabels,
        worksHasPhotos: worksHasPhotos,
      }) %>
    <% } %>
  </section>

  <% if (worksHasPhotos) { %>
    <%- include("partials/listing-works-modal", {
      listing: listing,
      linkedDpeInsights: typeof linkedDpeInsights !== 'undefined' ? linkedDpeInsights : null,
    }) %>
  <% } %>

  <%- include("partials/listing-extension-panel", {
    listing: listing,
    displayData: typeof displayData !== "undefined" ? displayData : null,
    travelHint: typeof travelHint !== "undefined" ? travelHint : null,
    showExtensionPanel: typeof showExtensionPanel !== "undefined" ? showExtensionPanel : false,
    travelPoll: typeof travelPoll !== "undefined" ? travelPoll : false,
    travelError: typeof travelError !== "undefined" ? travelError : null,
    travelConfigProject:
      typeof travelConfigProject !== "undefined" ? travelConfigProject : null,
    travelProjectAddresses:
      typeof travelProjectAddresses !== "undefined" ? travelProjectAddresses : [],
  }) %>

  <!-- Analyse de marché + territoire (enrichissement auto + polling si cache vide) -->
  <%- include("partials/listing-enrichment-live", {
    listing: listing,
    communeProviders: communeProviders,
    otherProviders: otherProviders,
    enrichmentPoll: enrichmentPoll
  }) %>

  <!-- 7. Financement -->
  <% if (listing.transaction_type !== 'rent') { %>
    <section class="panel" id="financement">
      <%- include("partials/financing", { listing: listing, financing: financing }) %>
    </section>
  <% } %>

  <!-- 8. Historique de prix -->
  <% if (priceHistory.length >= 2) { %>
    <section class="panel">
      <div class="panel__head">
        <div>
          <p class="panel__eyebrow">Suivi</p>
          <h2 class="panel__title">Historique de prix</h2>
        </div>
      </div>
      <div class="price-history">
        <% priceHistory.forEach(function (point, index) { %>
          <%
            const previous = index > 0 ? priceHistory[index - 1].price : null;
            const delta = previous !== null ? point.price - previous : null;
          %>
          <div class="price-history__row">
            <span><%= fmt.date(point.observed_at) %></span>
            <span>
              <strong><%= fmt.euro(point.price) %></strong>
              <% if (delta) { %>
                <span class="price-history__delta price-history__delta--<%= delta < 0 ? 'down' : 'up' %>">
                  <%= delta < 0 ? '−' : '+' %><%= fmt.euro(Math.abs(delta)) %>
                </span>
              <% } %>
            </span>
          </div>
        <% }); %>
      </div>
    </section>
  <% } %>

  <!-- 9. Notes personnelles -->
  <section class="panel">
    <div class="panel__head">
      <div>
        <p class="panel__eyebrow">Vous</p>
        <h2 class="panel__title">Notes personnelles</h2>
      </div>
      <span class="notes-status" id="notes-status">Enregistrement automatique</span>
    </div>

    <form
      hx-post="/listings/<%= listing.id %>"
      hx-trigger="keyup changed delay:800ms from:find textarea"
      hx-target="#notes-status"
      hx-swap="outerHTML"
    >
      <input type="hidden" name="view" value="notes" />
      <textarea
        class="textarea"
        name="notes"
        placeholder="Points forts, réserves, questions à poser à l'agence…"
        maxlength="20000"
      ><%= listing.notes || '' %></textarea>
    </form>
  </section>

  <!-- Suppression -->
  <section class="panel danger-zone">
    <div class="danger-zone__grid">
      <div class="danger-zone__copy">
        <div class="panel__head danger-zone__head">
          <h2 class="panel__title">Supprimer cette annonce</h2>
        </div>
        <p class="field__hint">
          L'annonce, ses photos, ses notes et son historique de prix sont
          définitivement supprimés.
        </p>
      </div>
      <div class="danger-zone__actions">
        <form
          method="post"
          action="/listings/<%= listing.id %>/delete"
          data-confirm="Supprimer définitivement cette annonce ?"
        >
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <button class="btn btn--danger" type="submit">Supprimer l'annonce</button>
        </form>
      </div>
    </div>
  </section>
</div>

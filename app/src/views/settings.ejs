<% if (errors && errors.length) { %>
  <div class="form-errors" role="alert" style="margin-bottom: var(--space-4)">
    <ul>
      <% errors.forEach(function (error) { %>
        <li><%= error %></li>
      <% }); %>
    </ul>
  </div>
<% } %>

<div class="settings-layout">
  <!-- --------------------------- Menu gauche --------------------------- -->
  <aside class="settings-menu">
    <div class="settings-menu__head">
      <h1 class="settings-menu__title">Paramètres</h1>
      <p class="settings-menu__subtitle">
        <%= user.email %> · <%= listingCount %> annonce<%= listingCount > 1 ? 's' : '' %> enregistrée<%= listingCount > 1 ? 's' : '' %>
      </p>
    </div>

    <nav class="settings-menu__nav" aria-label="Sections des paramètres">
      <button
        type="button"
        class="settings-menu__item is-active"
        data-settings-tab="extension"
        aria-selected="true"
      >
        <span class="settings-menu__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 3v3a2 2 0 0 1-4 0H3v4a2 2 0 0 1 0 4v4h4a2 2 0 0 1 4 0h4v-4a2 2 0 0 0 0-4V6h-4a2 2 0 0 0-4-3Z" />
          </svg>
        </span>
        <span class="settings-menu__text">
          <span class="settings-menu__label">Extension</span>
          <span class="settings-menu__hint">Navigateurs connectés</span>
        </span>
        <span class="settings-menu__chevron" aria-hidden="true">›</span>
      </button>

      <button
        type="button"
        class="settings-menu__item"
        data-settings-tab="addresses"
        aria-selected="false"
      >
        <span class="settings-menu__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 10c0 6-9 12-9 12s-9-6-9-12a9 9 0 0 1 18 0Z" />
            <circle cx="12" cy="10" r="3" />
          </svg>
        </span>
        <span class="settings-menu__text">
          <span class="settings-menu__label">Carnet d'adresses</span>
          <span class="settings-menu__hint">Adresses de référence</span>
        </span>
        <span class="settings-menu__chevron" aria-hidden="true">›</span>
      </button>

      <button
        type="button"
        class="settings-menu__item"
        data-settings-tab="security"
        aria-selected="false"
      >
        <span class="settings-menu__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <rect x="4" y="10" width="16" height="11" rx="2" />
            <path d="M8 10V7a4 4 0 0 1 8 0v3" />
          </svg>
        </span>
        <span class="settings-menu__text">
          <span class="settings-menu__label">Sécurité</span>
          <span class="settings-menu__hint">Mot de passe</span>
        </span>
        <span class="settings-menu__chevron" aria-hidden="true">›</span>
      </button>

      <button
        type="button"
        class="settings-menu__item settings-menu__item--danger"
        data-settings-tab="danger"
        aria-selected="false"
      >
        <span class="settings-menu__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 3 2 20h20L12 3Z" />
            <path d="M12 10v4M12 17.5v.5" />
          </svg>
        </span>
        <span class="settings-menu__text">
          <span class="settings-menu__label">Zone dangereuse</span>
          <span class="settings-menu__hint">Supprimer le compte</span>
        </span>
        <span class="settings-menu__chevron" aria-hidden="true">›</span>
      </button>
    </nav>
  </aside>

  <!-- -------------------------- Contenu droite ------------------------- -->
  <div class="settings-content">
    <!-- --------------------------- Extension -------------------------- -->
    <section class="panel settings-panel is-active" data-settings-panel="extension">
      <div class="panel__head">
        <div>
          <p class="panel__eyebrow">Extension</p>
          <h2 class="panel__title">Navigateurs connectés</h2>
        </div>
      </div>

      <p class="field__hint" style="margin-bottom: var(--space-4)">
        Rien à copier : dans l'extension, « S'authentifier » ouvre cette page,
        vous autorisez, et l'extension est connectée. Déconnecter un navigateur
        lui fera redemander votre autorisation.
      </p>

      <% if (!extensionSessions.length) { %>
        <p class="field__hint">
          Aucun navigateur connecté pour le moment.
        </p>
      <% } else { %>
        <ul class="device-list">
          <% extensionSessions.forEach(function (session) { %>
            <li>
              <div>
                <strong><%= session.label || 'Navigateur' %></strong>
                <div class="card__foot-note">
                  Connecté <%= fmt.relative(session.created_at) %>
                  <% if (session.last_used_at) { %>
                    · dernière annonce reçue <%= fmt.relative(session.last_used_at) %>
                  <% } else { %>
                    · aucune annonce reçue
                  <% } %>
                </div>
              </div>
              <form
                method="post"
                action="/settings/extension/<%= session.id %>/disconnect"
              >
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <button class="btn btn--ghost btn--sm" type="submit">
                  Déconnecter
                </button>
              </form>
            </li>
          <% }); %>
        </ul>
      <% } %>
    </section>

    <!-- ----------------------- Carnet d'adresses ---------------------- -->
    <section class="panel settings-panel" data-settings-panel="addresses" hidden>
      <div class="panel__head">
        <div>
          <p class="panel__eyebrow">Carnet d'adresses</p>
          <h2 class="panel__title">Adresses de référence</h2>
        </div>
      </div>

      <p class="field__hint" style="margin-bottom: var(--space-4)">
        Ces adresses (domicile, bureau, école, gare…) servent à calculer le
        temps de trajet dans vos projets. Une adresse ajoutée à un projet
        rejoint ce carnet. Le crayon à côté du libellé ou de l'adresse permet
        de les modifier sur place : le changement est enregistré en quittant
        le champ et se répercute sur tous les projets qui l'utilisent. La
        supprimer la retirera de tous les projets.
      </p>

      <%- include("partials/address-book") %>
    </section>

    <!-- -------------------------- Mot de passe ------------------------ -->
    <section class="panel settings-panel" data-settings-panel="security" hidden>
      <div class="panel__head">
        <div>
          <p class="panel__eyebrow">Sécurité</p>
          <h2 class="panel__title">Mot de passe</h2>
        </div>
      </div>

      <form class="form" method="post" action="/settings/password">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

        <div class="field">
          <label class="field__label" for="current_password">
            Mot de passe actuel
          </label>
          <input
            class="input"
            type="password"
            id="current_password"
            name="current_password"
            autocomplete="current-password"
            required
          />
        </div>

        <div class="field">
          <label class="field__label" for="new_password">Nouveau mot de passe</label>
          <input
            class="input"
            type="password"
            id="new_password"
            name="password"
            autocomplete="new-password"
            minlength="10"
            required
          />
          <span class="field__hint">10 caractères minimum.</span>
        </div>

        <div class="field">
          <label class="field__label" for="new_password_confirm">
            Confirmation
          </label>
          <input
            class="input"
            type="password"
            id="new_password_confirm"
            name="password_confirm"
            autocomplete="new-password"
            minlength="10"
            required
          />
        </div>

        <button class="btn btn--green" type="submit">Modifier</button>
      </form>
    </section>

    <!-- ------------------------ Zone dangereuse ---------------------- -->
    <section class="panel danger-zone settings-panel" data-settings-panel="danger" hidden>
      <div class="panel__head">
        <div>
          <p class="panel__eyebrow">Zone dangereuse</p>
          <h2 class="panel__title">Supprimer le compte</h2>
        </div>
      </div>

      <p class="field__hint" style="margin-bottom: var(--space-4)">
        Toutes vos annonces, notes, photos, historiques de prix et connexions de
        l'extension sont définitivement supprimés. Cette action est irréversible.
      </p>

      <form class="form" method="post" action="/settings/delete">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <div class="field">
          <label class="field__label" for="confirm">
            Saisissez SUPPRIMER pour confirmer
          </label>
          <input
            class="input"
            type="text"
            id="confirm"
            name="confirm"
            autocomplete="off"
            placeholder="SUPPRIMER"
          />
        </div>
        <button class="btn btn--danger" type="submit">
          Supprimer définitivement mon compte
        </button>
      </form>
    </section>
  </div>
</div>

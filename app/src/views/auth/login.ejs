<div class="auth">
  <div class="panel">
    <h1 class="auth__title">Connexion</h1>
    <p class="auth__lead">Retrouvez votre Carnet de Visites.</p>

    <% if (errors.length) { %>
      <div class="form-errors" role="alert">
        <ul>
          <% errors.forEach(function (error) { %>
            <li><%= error %></li>
          <% }); %>
        </ul>
      </div>
    <% } %>

    <form class="form" method="post" action="/login" style="margin-top: var(--space-4)">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <input type="hidden" name="next" value="<%= next %>" />

      <div class="field">
        <label class="field__label" for="email">Adresse e-mail</label>
        <input
          class="input"
          type="email"
          id="email"
          name="email"
          autocomplete="email"
          required
          value="<%= values.email || '' %>"
        />
      </div>

      <div class="field">
        <label class="field__label" for="password">Mot de passe</label>
        <input
          class="input"
          type="password"
          id="password"
          name="password"
          autocomplete="current-password"
          required
        />
      </div>

      <button class="btn btn--green btn--block" type="submit">Se connecter</button>
    </form>

    <p class="auth__foot">
      Pas encore de compte ?
      <a href="/signup?next=<%= encodeURIComponent(next) %>">Créer un compte</a>
    </p>
  </div>
</div>

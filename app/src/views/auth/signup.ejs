<div class="auth">
  <div class="panel">
    <h1 class="auth__title">Créer un compte</h1>
    <p class="auth__lead">
      Un compte, une recherche. Vos annonces restent privées.
    </p>

    <% if (errors.length) { %>
      <div class="form-errors" role="alert">
        <ul>
          <% errors.forEach(function (error) { %>
            <li><%= error %></li>
          <% }); %>
        </ul>
      </div>
    <% } %>

    <form class="form" method="post" action="/signup" style="margin-top: var(--space-4)">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <input type="hidden" name="next" value="<%= next %>" />

      <div class="field">
        <label class="field__label" for="email">Adresse e-mail</label>
        <input
          class="input"
          type="email"
          id="email"
          name="email"
          autocomplete="email"
          required
          value="<%= values.email || '' %>"
        />
      </div>

      <div class="field">
        <label class="field__label" for="password">Mot de passe</label>
        <input
          class="input"
          type="password"
          id="password"
          name="password"
          autocomplete="new-password"
          minlength="10"
          required
        />
        <span class="field__hint">10 caractères minimum.</span>
      </div>

      <div class="field">
        <label class="field__label" for="password_confirm">
          Confirmation du mot de passe
        </label>
        <input
          class="input"
          type="password"
          id="password_confirm"
          name="password_confirm"
          autocomplete="new-password"
          minlength="10"
          required
        />
      </div>

      <button class="btn btn--green btn--block" type="submit">
        Créer mon compte
      </button>
    </form>

    <p class="auth__foot">
      Déjà inscrit ?
      <a href="/login?next=<%= encodeURIComponent(next) %>">Se connecter</a>
    </p>
  </div>
</div>

<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <% const seo = locals.seo || null; %>
    <meta name="robots" content="<%= seo ? 'index, follow' : 'noindex, nofollow' %>" />
    <meta name="csrf-token" content="<%= csrfToken %>" />
    <meta name="theme-color" content="#0b3d2c" />
    <% if (seo) { %>
      <title><%= seo.title %></title>
      <meta name="description" content="<%= seo.description %>" />
      <link rel="canonical" href="<%= seo.url %>" />
      <meta property="og:type" content="website" />
      <meta property="og:locale" content="fr_FR" />
      <meta property="og:site_name" content="Carnet de Visites" />
      <meta property="og:title" content="<%= seo.title %>" />
      <meta property="og:description" content="<%= seo.description %>" />
      <meta property="og:url" content="<%= seo.url %>" />
      <meta name="twitter:card" content="summary" />
      <% if (seo.jsonLd) { %>
        <script type="application/ld+json"><%- JSON.stringify(seo.jsonLd).replace(/</g, "\\u003c") %></script>
      <% } %>
    <% } else { %>
      <title><%= title %> · Carnet de Visites</title>
    <% } %>
    <% (locals.preloadFonts || []).forEach(function (href) { %>
      <link rel="preload" href="<%= href %>" as="font" type="font/woff2" crossorigin />
    <% }) %>
    <link rel="stylesheet" href="/public/css/app.css?v=<%= assetVersion %>" />
    <% (locals.styles || []).forEach(function (href) { %>
      <link rel="stylesheet" href="<%= href %>?v=<%= assetVersion %>" />
    <% }) %>
    <link rel="icon" href="/public/favicon.svg" type="image/svg+xml" />
    <script src="/public/js/htmx.min.js" defer></script>
    <script src="/public/js/app.js?v=<%= assetVersion %>" defer></script>
    <% (locals.scripts || []).forEach(function (src) { %>
      <script src="<%= src %>?v=<%= assetVersion %>" defer></script>
    <% }) %>
  </head>
  <body>
    <%- include("partials/nav") %>

    <main class="<%= locals.mainClass || 'page' %>">
      <%- include("partials/flash") %>
      <%- body %>
    </main>

    <footer class="site-footer">
      <p>
        Carnet de Visites — données privées, visibles de vous seul.
      </p>
    </footer>

    <!-- Modale de confirmation réutilisable : alimentée par les formulaires
         portant un attribut `data-confirm` (voir app.js). -->
    <div class="modal modal--dpe-detail" id="dpe-detail-modal" hidden>
      <div class="modal__overlay" data-dpe-detail-dismiss></div>
      <div
        class="modal__dialog modal__dialog--wide dpe-detail-dialog"
        role="dialog"
        aria-modal="true"
        aria-labelledby="dpe-detail-modal-title"
      >
        <button
          type="button"
          class="modal__close dpe-detail-dialog__close"
          data-dpe-detail-dismiss
          aria-label="Fermer"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M18 6 6 18" />
            <path d="m6 6 12 12" />
          </svg>
        </button>
        <div class="dpe-detail-dialog__content" data-dpe-detail-content>
          <p class="dpe-detail-dialog__loading">Chargement…</p>
        </div>
      </div>
    </div>

    <div class="modal" id="confirm-modal" hidden>
      <div class="modal__overlay" data-modal-dismiss></div>
      <div
        class="modal__dialog"
        role="alertdialog"
        aria-modal="true"
        aria-labelledby="confirm-modal-title"
        aria-describedby="confirm-modal-message"
      >
        <h2 class="modal__title" id="confirm-modal-title" data-modal-title>
          Confirmer
        </h2>
        <p class="modal__message" id="confirm-modal-message" data-modal-message></p>
        <div class="modal__actions">
          <button type="button" class="btn btn--ghost" data-modal-dismiss>
            Annuler
          </button>
          <button type="button" class="btn btn--danger-solid" data-modal-confirm>
            Supprimer
          </button>
        </div>
      </div>
    </div>
  </body>
</html>

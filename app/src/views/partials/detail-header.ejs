<%
  const isRejected = listing.status === "rejected";
%>
<div class="detail-head" id="detail-header">
  <div class="detail-head__intro">
    <h1 class="detail-title">
      <%= listing.title ? fmt.listingTitle(listing.title, listing.price) : (fmt.propertyTypeLabel(listing.property_type) || 'Annonce') %>
    </h1>

    <div class="detail-meta">
      <span class="badge badge--<%= fmt.statusTone(listing.status) %>">
        <%= fmt.statusBadgeLabel(listing.status) %>
      </span>
      <% if (listing.transaction_type === 'rent') { %>
        <span class="badge badge--warn">Location</span>
      <% } %>
      <% if (listing.is_new_build) { %>
        <span class="badge badge--accent">Neuf</span>
      <% } %>
      <% if (listing.price_change) { %>
        <span class="badge badge--<%= listing.price_change.direction %>">
          <%= listing.price_change.direction === 'down' ? 'Baisse' : 'Hausse' %>
          de <%= fmt.euro(Math.abs(listing.price_change.delta)) %>
        </span>
      <% } %>
      <span class="badge badge--muted">
        Origine : <%= fmt.sourceLabel(listing.source) %>
      </span>
    </div>
  </div>

  <div class="detail-head__price">
    <p class="detail-price"><%= fmt.euro(listing.price) %></p>
    <% if (listing.price_per_m2) { %>
      <span class="detail-price__unit"><%= fmt.euro(listing.price_per_m2) %> / m²</span>
    <% } %>
    <span class="detail-price__unit">
      Enregistrée <%= fmt.relative(listing.first_saved_at) %>
    </span>
  </div>

  <div class="btn-row detail-head__toolbar">
    <%- include("project-dropdown", { listing: listing, projects: projects }) %>

    <a
      class="btn btn--ghost btn--sm detail-head__origin-link"
      href="<%= listing.url %>"
      target="_blank"
      rel="noreferrer noopener"
      >Voir l'annonce d'origine <span class="link-exit-arrow" aria-hidden="true">↗</span></a
    >

    <div class="detail-head__icon-actions">
      <form
        hx-post="/listings/<%= listing.id %>"
        hx-target="#listing-lead"
        hx-swap="outerHTML"
      >
        <input type="hidden" name="view" value="header" />
        <input type="hidden" name="is_favorite" value="<%= listing.is_favorite ? '0' : '1' %>" />
        <button
          class="btn btn--sm btn--icon-only detail-head__fav-btn <%= listing.is_favorite ? 'btn--gold' : 'btn--ghost btn--fav-add' %>"
          type="submit"
          title="<%= listing.is_favorite ? 'Retirer des favoris' : 'Ajouter aux favoris' %>"
          aria-label="<%= listing.is_favorite ? 'Retirer des favoris' : 'Ajouter aux favoris' %>"
          aria-pressed="<%= listing.is_favorite ? 'true' : 'false' %>"
        >
          <svg
            viewBox="0 0 24 24"
            width="18"
            height="18"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
          </svg>
        </button>
      </form>

      <form
        method="post"
        action="/listings/<%= listing.id %>/delete"
        data-confirm="Supprimer cette annonce ? Cette action est irréversible."
        data-confirm-title="Supprimer l'annonce"
      >
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <button
          class="btn btn--sm btn--ghost btn--danger-ghost btn--icon-only detail-head__delete-btn"
          type="submit"
          title="Supprimer l'annonce"
          aria-label="Supprimer l'annonce"
        >
          <svg
            viewBox="0 0 24 24"
            width="18"
            height="18"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M3 6h18" />
            <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6" />
            <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2" />
          </svg>
        </button>
      </form>
    </div>
  </div>

  <div class="detail-head__reject">
    <a
      href="/listings/<%= listing.id %>/visite"
      class="btn btn--green btn--sm offer-cta detail-head__offer-btn"
      data-visit-open
      title="Préparer votre visite : questions à poser et points à vérifier"
    >
      <svg class="wi" aria-hidden="true"><use href="#wi-clipboard"></use></svg>
      <span class="detail-head__visit-label-full">Préparer la visite</span>
      <span class="detail-head__visit-label-short">Visite</span>
    </a>
    <% if (listing.transaction_type !== 'rent' && listing.price) { %>
      <button
        type="button"
        class="btn btn--green btn--sm offer-cta detail-head__offer-btn"
        data-offer-open
        title="Préparer une proposition d'achat à envoyer à l'agence ou au propriétaire"
      >
        <svg class="wi" aria-hidden="true"><use href="#wi-coins"></use></svg>
        <span class="detail-head__offer-label-full">Rédaction de l'offre</span>
        <span class="detail-head__offer-label-short">Rédaction</span>
      </button>
    <% } %>
    <form
      method="post"
      action="/listings/<%= listing.id %>"
      hx-post="/listings/<%= listing.id %>"
      hx-target="#listing-lead"
      hx-swap="outerHTML"
    >
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <input type="hidden" name="view" value="header" />
      <button
        class="btn btn--sm status-pipe__reject<%= isRejected ? ' is-active' : ' btn--danger' %>"
        type="submit"
        name="status"
        value="rejected"
        aria-pressed="<%= isRejected ? 'true' : 'false' %>"
        title="<%= isRejected ? 'Cliquer pour réactiver le parcours' : 'Cliquer pour écarter cette annonce' %>"
        aria-label="<%= isRejected ? 'Réactiver le parcours à l\'étape précédente' : 'Écarter cette annonce' %>"
      >
        <span class="status-pipe__reject-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="8"/><path d="m9 9 6 6M15 9l-6 6"/>
          </svg>
        </span>
        <% if (isRejected) { %>
          <span class="status-pipe__reject-label-full">Réactiver cette annonce</span>
          <span class="status-pipe__reject-label-short">Réactiver</span>
        <% } else { %>
          <span class="status-pipe__reject-label-full">Écarter cette annonce</span>
          <span class="status-pipe__reject-label-short">Écarter</span>
        <% } %>
      </button>
    </form>
  </div>
</div>

<%
  // Panneau « État visible du bien » : lecture immobilière des photos.
  // `photoAnalysis` vient de photoAnalysisViewModel ; `photoLabels` des libellés.
  var pa = photoAnalysis;
  var L = photoLabels;
  var panelUrl = "/listings/" + listing.id + "/photo-analysis/panel";
  var pending = !pa.ready;

  function lbl(map, key, fallback) { return L.label(map, key, fallback); }
%>
<section
  class="works__part photo-analysis"
  id="listing-photo-analysis"
  aria-labelledby="listing-works-title"
  data-photo-analysis
  data-photo-analysis-url="<%= panelUrl %>"
  <% if (pa.ready && pa.status === "ok") {
       var badgePayload = {};
       Object.keys(pa.galleryBadges || {}).forEach(function (i) {
         var cls = pa.galleryBadges[i];
         if (L.GALLERY_BADGES[cls]) badgePayload[i] = { cls: cls, label: L.GALLERY_BADGES[cls] };
       });
  %>
  data-gallery-badges="<%= encodeURIComponent(JSON.stringify(badgePayload)) %>"
  <% } %>
  <% if (pending) { %>
  hx-get="<%= panelUrl %>"
  hx-trigger="every 4s"
  hx-swap="outerHTML"
  <% } %>
  <% if (typeof hxSwapOob !== "undefined" && hxSwapOob) { %>
  hx-swap-oob="true"
  <% } %>
>
  <% if (pending) { %>
    <div class="pa-pending" role="status">
      <span class="spinner" aria-hidden="true"></span>
      <div>
        <p class="pa-pending__title">Analyse des photos en cours…</p>
        <p class="field__hint">Classification des images, identification des pièces, repérage des travaux et anomalies visibles. Comptez environ une à deux minutes selon le nombre de photos ; la page se met à jour automatiquement.</p>
      </div>
    </div>
  <% } else if (pa.status !== "ok") { %>
    <p class="field__hint pa-empty">
      <% if (pa.status === "insufficient") { %>
        Aucune photo exploitable dans cette annonce : l'état visible du bien ne peut pas être évalué.
      <% } else { %>
        L'analyse des photos n'est pas disponible pour cette annonce<%= pa.warnings && pa.warnings[0] ? " (" + pa.warnings[0].replace(/\.$/, "") + ")" : "" %>.
      <% } %>
    </p>
  <% } else { %>
    <%
      var ws = typeof worksSummary !== "undefined" ? worksSummary : null;
      var condTone = ws && ws.health ? ws.health.tone : lbl(L.CONDITION_TONES, pa.condition.label, "unknown");
    %>

    <!-- 1. Verdict -->
    <div class="pa-hero">
      <div class="pa-hero__head">
        <%- include("listing-works-verdict", { worksSummary: ws, photoAnalysis: pa, photoLabels: L, hxSwapOob: false }) %>
        <div class="pa-hero__side">
        <div class="pa-hero__stats" aria-label="Indicateurs issus des photos exploitables">
          <div class="pa-hero__stat pa-hero__stat--metrics pa-hero__stat--<%= condTone %>">
            <div class="pa-hero__stat-row">
              <%- include("listing-works-budget", {
                worksSummary: typeof worksSummary !== "undefined" ? worksSummary : null,
                hxSwapOob: false,
              }) %>
              <%- include("listing-works-health", {
                worksSummary: typeof worksSummary !== "undefined" ? worksSummary : null,
                hxSwapOob: false,
              }) %>
              <div class="pa-hero__stat-col pa-hero__stat-col--divider pa-hero__stat-col--quality">
                <span class="pa-hero__stat-name">Fiabilité de l'analyse</span>
                <span class="pa-hero__stat-value"><%= lbl(L.QUALITY_CONFIDENCE_LABELS, pa.quality.confidence) %> : <%= pa.quality.score %><span class="pa-hero__stat-unit">%</span></span>
                <div class="pa-hero__stat-track pa-hero__stat-track--quality" role="presentation" aria-hidden="true">
                  <span class="pa-hero__stat-fill" style="width: <%= Math.max(0, Math.min(100, Number(pa.quality.score) || 0)) %>%;"></span>
                </div>
                <% if (pa.virtualImageCount || pa.quality.partial) { %>
                  <span class="pa-hero__stat-hint">
                    <% if (pa.virtualImageCount) { %><%= pa.virtualImageCount %> projection<%= pa.virtualImageCount > 1 ? "s" : "" %> exclue<%= pa.virtualImageCount > 1 ? "s" : "" %><% } %><% if (pa.virtualImageCount && pa.quality.partial) { %> · <% } %><% if (pa.quality.partial) { %>analyse partielle<% } %>
                  </span>
                <% } %>
              </div>
            </div>
          </div>
        </div>
        </div>
      </div>
      <% if (pa.summary || pa.renovation.cosmetic_only_suspected) { %>
        <div class="pa-hero__detail">
          <% if (pa.summary) { %>
            <p class="pa-hero__summary"><%= pa.summary %></p>
          <% } %>
          <% if (pa.renovation.cosmetic_only_suspected) { %>
            <p class="pa-hero__note">Rénovation visiblement esthétique, mais certains équipements semblent plus anciens.</p>
          <% } %>
        </div>
      <% } %>
    </div>

    <div
      id="listing-works-metrics-sync"
      hx-get="/listings/<%= listing.id %>/works/summary"
      hx-trigger="works-plan-saved from:body"
      hx-swap="none"
      hidden
      aria-hidden="true"
    ></div>

    <p class="panel__note photo-analysis__note">
      Anomalies, cohérence de l'annonce et points à vérifier en visite : voir le
      <button type="button" class="works-link" data-works-open>dossier technique</button>.
      Lecture automatique de l'état <strong>visible</strong> sur les photos : elle ne remplace ni une visite ni un diagnostic technique.
      <% if (pa.analyzedAt) { %>Analyse du <%= fmt.date(pa.analyzedAt) %>.<% } %>
    </p>
  <% } %>
</section>
<% if (typeof refreshWorksHeadAside !== "undefined" && refreshWorksHeadAside) { %>
<%- include("listing-works-head-aside", {
  listing: listing,
  photoAnalysis: photoAnalysis,
  photoLabels: photoLabels,
  worksHasPhotos: typeof worksHasPhotos !== "undefined" && worksHasPhotos,
  hxSwapOob: true,
}) %>
<% } %>
<% if (typeof financingOob !== "undefined" && financingOob) { %>
<%- include("financing", {
  listing: listing,
  financing: financingOob,
  hxSwapOob: true,
  pricePositionOob: typeof pricePositionOob !== "undefined" ? pricePositionOob : null,
}) %>
<% } %>

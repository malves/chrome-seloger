<%
  const params = financing.params;
  const r = financing.result;
  const amortization = financing.amortization;
%>
<%
  const rentYield = financing.rentYield || null;
  const marketEstimate = financing.marketEstimate > 0 ? financing.marketEstimate : null;
  const yieldAttract =
    financing.rentYieldGrade ||
    (rentYield && rentYield.attractiveness ? rentYield.attractiveness : null);
  const YIELD_GRADE_LETTERS = ['A', 'B', 'C', 'D', 'E', 'F'];
  const YIELD_GRADE_COLORS = ['#319834', '#5faa32', '#a7c62c', '#f2d307', '#eca40c', '#e2691b'];
  const yieldGradeIdx =
    yieldAttract && yieldAttract.grade
      ? YIELD_GRADE_LETTERS.indexOf(String(yieldAttract.grade).toUpperCase())
      : -1;
  const showYieldGrade = Boolean(marketEstimate);
  const financingUpdatedAt = financing.updatedAt || null;
%>
<div
  id="financing-block"
  <% if (rentYield) { %>data-financing-annual-rent="<%= rentYield.annualRent %>"<% } %>
  <% if (marketEstimate) { %>data-financing-market-estimate="<%= marketEstimate %>"<% } %>
  <% if (typeof hxSwapOob !== "undefined" && hxSwapOob) { %> hx-swap-oob="true"<% } %>
>
  <div class="panel__head">
    <div>
      <p class="panel__eyebrow">Budget</p>
      <h2 class="panel__title">Financement</h2>
    </div>
    <div class="panel__head-aside">
      <% if (financingUpdatedAt) { %>
        <span class="card__foot-note">
          Mise à jour <%= fmt.relative(financingUpdatedAt) %>
        </span>
      <% } %>
      <button
        type="button"
        class="btn btn--ghost btn--sm"
        data-financing-amortization-open
        aria-haspopup="dialog"
        aria-controls="financing-amortization-modal"
        <% if (r.isFullyFunded) { %>disabled title="Aucun emprunt : l'apport couvre le projet."<% } %>
      >
        Tableau d'amortissement
      </button>
    </div>
  </div>
  <div class="listing-financing__body">
<div class="financing__grid">
  <!-- Colonne gauche : paramètres de la simulation -->
  <section class="financing-card financing-card--params">
    <header class="financing-card__head">
      <h3 class="financing-card__title">Paramètres</h3>
      <p class="financing-card__subtitle">Le calcul se met à jour automatiquement.</p>
    </header>

    <form
      class="financing-params"
      hx-post="/listings/<%= listing.id %>/financing"
      hx-target="#financing-block"
      hx-swap="outerHTML"
      hx-trigger="change, submit"
      hx-sync="this:replace"
    >
      <div class="field">
        <label class="field__label" for="financing-negotiated-price">Prix négocié (€)</label>
        <%
          const officialPrice = Number(listing.price) || 0;
          const negotiated = Number(params.negotiatedPrice) || 0;
          const gapPct = officialPrice > 0
            ? Math.round(((negotiated - officialPrice) / officialPrice) * 1000) / 10
            : null;
        %>
        <div class="amount-stepper">
          <input
            id="financing-negotiated-price"
            class="input input--sm"
            type="text"
            inputmode="numeric"
            autocomplete="off"
            name="negotiated_price"
            data-amount
            data-step="1000"
            value="<%= fmt.number(params.negotiatedPrice) %>"
            <% if (gapPct !== null) { %>aria-describedby="financing-price-gap"<% } %>
            <% if (officialPrice > 0) { %>data-negotiated-price data-official-price="<%= officialPrice %>"<% } %>
          />
          <span class="amount-stepper__controls">
            <button type="button" class="amount-stepper__btn amount-stepper__btn--up" data-amount-step="1" aria-label="Augmenter le prix négocié de 1 000 euros"></button>
            <button type="button" class="amount-stepper__btn amount-stepper__btn--down" data-amount-step="-1" aria-label="Diminuer le prix négocié de 1 000 euros"></button>
          </span>
        </div>
        <% if (gapPct !== null) { %>
          <span id="financing-price-gap" class="price-gap field__hint" data-price-gap>
            <% if (gapPct < 0) { %>
              <span class="price-gap__value price-gap__value--down">−<%= Math.abs(gapPct).toLocaleString('fr-FR', { maximumFractionDigits: 1 }) %> %</span>
              sous le prix officiel (<%= fmt.euro(officialPrice) %>)
            <% } else if (gapPct > 0) { %>
              <span class="price-gap__value price-gap__value--up">+<%= gapPct.toLocaleString('fr-FR', { maximumFractionDigits: 1 }) %> %</span>
              au-dessus du prix officiel (<%= fmt.euro(officialPrice) %>)
            <% } else { %>
              Au prix officiel (<%= fmt.euro(officialPrice) %>)
            <% } %>
          </span>
        <% } %>
      </div>

      <div class="field">
        <label class="field__label" for="financing-works">Travaux (€)</label>
        <div class="amount-stepper">
          <input id="financing-works" class="input input--sm" type="text" inputmode="numeric" autocomplete="off" name="works" data-amount data-step="1000" value="<%= fmt.number(params.works) %>" />
          <span class="amount-stepper__controls">
            <button type="button" class="amount-stepper__btn amount-stepper__btn--up" data-amount-step="1" aria-label="Augmenter les travaux de 1 000 euros"></button>
            <button type="button" class="amount-stepper__btn amount-stepper__btn--down" data-amount-step="-1" aria-label="Diminuer les travaux de 1 000 euros"></button>
          </span>
        </div>
      </div>

      <div class="field">
        <label class="field__label" for="financing-down-payment">Apport (€)</label>
        <div class="amount-stepper">
          <input id="financing-down-payment" class="input input--sm" type="text" inputmode="numeric" autocomplete="off" name="down_payment" data-amount data-step="1000" value="<%= fmt.number(params.downPayment) %>" />
          <span class="amount-stepper__controls">
            <button type="button" class="amount-stepper__btn amount-stepper__btn--up" data-amount-step="1" aria-label="Augmenter l'apport de 1 000 euros"></button>
            <button type="button" class="amount-stepper__btn amount-stepper__btn--down" data-amount-step="-1" aria-label="Diminuer l'apport de 1 000 euros"></button>
          </span>
        </div>
      </div>

      <div class="field">
        <label class="field__label" for="financing-years">Durée (ans)</label>
        <div class="amount-stepper">
          <input id="financing-years" class="input input--sm" type="text" inputmode="numeric" autocomplete="off" name="years" data-step="1" data-min="1" data-max="40" data-decimals="0" value="<%= params.years %>" />
          <span class="amount-stepper__controls">
            <button type="button" class="amount-stepper__btn amount-stepper__btn--up" data-amount-step="1" aria-label="Augmenter la durée d'un an"></button>
            <button type="button" class="amount-stepper__btn amount-stepper__btn--down" data-amount-step="-1" aria-label="Diminuer la durée d'un an"></button>
          </span>
        </div>
      </div>

      <div class="field">
        <label class="field__label" for="financing-interest-rate">Taux nominal (%)</label>
        <div class="amount-stepper">
          <input id="financing-interest-rate" class="input input--sm" type="text" inputmode="decimal" autocomplete="off" name="interest_rate" data-step="0.01" data-min="0" data-max="25" data-decimals="2" value="<%= (params.interestRate * 100).toLocaleString('fr-FR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>" />
          <span class="amount-stepper__controls">
            <button type="button" class="amount-stepper__btn amount-stepper__btn--up" data-amount-step="1" aria-label="Augmenter le taux nominal de 0,01 point"></button>
            <button type="button" class="amount-stepper__btn amount-stepper__btn--down" data-amount-step="-1" aria-label="Diminuer le taux nominal de 0,01 point"></button>
          </span>
        </div>
      </div>

      <div class="field">
        <label class="field__label" for="financing-insurance-rate">Assurance (%)</label>
        <div class="amount-stepper">
          <input id="financing-insurance-rate" class="input input--sm" type="text" inputmode="decimal" autocomplete="off" name="insurance_rate" data-step="0.01" data-min="0" data-max="5" data-decimals="2" value="<%= (params.insuranceRate * 100).toLocaleString('fr-FR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>" />
          <span class="amount-stepper__controls">
            <button type="button" class="amount-stepper__btn amount-stepper__btn--up" data-amount-step="1" aria-label="Augmenter l'assurance de 0,01 point"></button>
            <button type="button" class="amount-stepper__btn amount-stepper__btn--down" data-amount-step="-1" aria-label="Diminuer l'assurance de 0,01 point"></button>
          </span>
        </div>
      </div>

    </form>
  </section>

  <!-- Colonne droite : résultats du calcul (inchangés) -->
  <section class="financing-card financing-card--result">
    <header class="financing-card__head">
      <h3 class="financing-card__title">Simulation de crédit</h3>
      <p class="financing-card__subtitle">Coût d'acquisition et mensualités estimés.</p>
    </header>

    <table class="specs">
    <tbody>
      <tr>
        <th>Prix retenu</th>
        <td><%= fmt.euro(r.price) %></td>
      </tr>
      <tr>
        <th>
          Frais de notaire
          <span class="field__hint">(<%= fmt.percent(r.notaryRate) %>, <%= listing.is_new_build ? 'neuf' : 'ancien' %>)</span>
        </th>
        <td><%= fmt.euro(r.notaryFees) %></td>
      </tr>
      <tr>
        <th>
          Frais d'agence
          <% if (listing.agency && listing.agency.fees_included !== false) { %>
            <span class="field__hint">(inclus dans le prix)</span>
          <% } %>
        </th>
        <td><%= fmt.euro(r.agencyFees) %></td>
      </tr>
      <tr>
        <th>Travaux</th>
        <td><%= fmt.euro(r.works) %></td>
      </tr>
      <tr data-financing-gross-yield-row>
        <th>Rendement brut locatif</th>
        <td>
          <div class="financing__yield-row">
            <div
              class="financing__yield-scale-wrap"
              data-financing-yield-grade
              <% if (!showYieldGrade) { %>hidden<% } %>
            >
              <div
                class="financing__yield-scale"
                role="img"
                data-financing-yield-scale
                <% if (yieldAttract) { %>
                  aria-label="Attractivité du rendement : <%= yieldAttract.grade %>. <%= yieldAttract.grade_label %>"
                <% } %>
              >
                <% YIELD_GRADE_LETTERS.forEach(function (letter, i) {
                  const isOn = i === yieldGradeIdx;
                  const darkText = isOn && i >= 2 && i <= 4;
                %>
                  <span
                    class="financing__yield-seg<%= isOn ? ' is-active' : '' %><%= darkText ? ' is-active--dark' : '' %>"
                    style="background: <%= YIELD_GRADE_COLORS[i] %>"
                    <% if (isOn && yieldAttract) { %>title="<%= yieldAttract.grade_label %>"<% } %>
                  ><%= isOn ? letter : '' %></span>
                <% }); %>
              </div>
            </div>
            <strong class="financing__yield-pct" data-financing-gross-yield>
              <% if (rentYield) { %>
                <%= fmt.percent(rentYield.pct / 100, 2) %>
              <% } else { %>
                —
              <% } %>
            </strong>
          </div>
        </td>
      </tr>
      <tr class="specs--total">
        <th>Coût total du projet</th>
        <td><%= fmt.euro(r.totalCost) %></td>
      </tr>
      <tr>
        <th>Apport</th>
        <td>− <%= fmt.euro(r.downPayment) %></td>
      </tr>
      <tr>
        <th>
          Frais de garantie et de dossier
          <span class="field__hint">(<%= fmt.percent(r.guaranteeRate) %>)</span>
        </th>
        <td><%= fmt.euro(r.guaranteeFees) %></td>
      </tr>
      <tr class="specs--total">
        <th>Montant emprunté</th>
        <td><%= fmt.euro(r.loanAmount) %></td>
      </tr>
      <tr>
        <th>Mensualité hors assurance</th>
        <td><%= fmt.euro(r.paymentExcludingInsurance) %></td>
      </tr>
      <tr>
        <th>Assurance mensuelle</th>
        <td><%= fmt.euro(r.monthlyInsurance) %></td>
      </tr>
      <tr class="specs--total specs--strong">
        <th>Mensualité totale <span class="field__hint">(sur <%= r.months %> mois)</span></th>
        <td><%= fmt.euro(r.totalMonthly) %> / mois</td>
      </tr>
      <tr class="specs--strong">
        <th>Coût total du crédit</th>
        <td><%= fmt.euro(r.creditCost) %></td>
      </tr>
      <tr class="specs--strong">
        <th>
          Revenu mensuel minimum
          <span class="field__hint">(endettement <%= fmt.percent(r.debtRatio, 0) %>)</span>
        </th>
        <td><%= fmt.euro(r.minimumIncome) %></td>
      </tr>
    </tbody>
  </table>

    <% if (!r.isFullyFunded) { %>
      <a
        class="financing__debt-link"
        href="/endettement?mensualite=<%= Math.round(r.totalMonthly) %>&source=<%= encodeURIComponent(listing.title || 'cette annonce') %>"
      >
        Vérifier si ma situation permet ce projet
        <span aria-hidden="true">→</span>
      </a>
    <% } %>

    <% if (r.isFullyFunded) { %>
      <p class="panel__note">
        L'apport couvre la totalité du projet : aucun emprunt n'est nécessaire.
      </p>
    <% } %>
  </section>
</div>

<% if (!r.isFullyFunded) { %>
  <%- include("financing-amortization-modal", { r: r, amortization: amortization }) %>
<% } %>
  </div>
</div>
<% if (typeof pricePositionOob !== "undefined" && pricePositionOob) { %>
  <%- include("enrichment/price-position", {
    position: pricePositionOob.position,
    listing: listing,
    dvfRadius: pricePositionOob.dvfRadius,
    hxSwapOob: true,
  }) %>
<% } %>

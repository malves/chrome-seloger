<aside class="settings-menu">
  <div class="settings-menu__head">
    <h1 class="settings-menu__title">Administration</h1>
  </div>

  <nav class="settings-menu__nav" aria-label="Sections de l'administration">
    <a
      href="/admin/dpe"
      class="settings-menu__item <%= adminSection === 'dpe' ? 'is-active' : '' %>"
      <%= adminSection === 'dpe' ? 'aria-current="page"' : '' %>
    >
      <span class="settings-menu__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
          <path d="M9 22V12h6v10" />
        </svg>
      </span>
      <span class="settings-menu__text">
        <span class="settings-menu__label">DPE</span>
        <span class="settings-menu__hint">Import &amp; recherche ADEME</span>
      </span>
      <span class="settings-menu__chevron" aria-hidden="true">›</span>
    </a>

    <a
      href="/admin/ssmsi"
      class="settings-menu__item <%= adminSection === 'ssmsi' ? 'is-active' : '' %>"
      <%= adminSection === 'ssmsi' ? 'aria-current="page"' : '' %>
    >
      <span class="settings-menu__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
        </svg>
      </span>
      <span class="settings-menu__text">
        <span class="settings-menu__label">Import SSMSI</span>
        <span class="settings-menu__hint">Délinquance enregistrée</span>
      </span>
      <span class="settings-menu__chevron" aria-hidden="true">›</span>
    </a>

    <a
      href="/admin/hexasmal"
      class="settings-menu__item <%= adminSection === 'hexasmal' ? 'is-active' : '' %>"
      <%= adminSection === 'hexasmal' ? 'aria-current="page"' : '' %>
    >
      <span class="settings-menu__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 6h16" />
          <path d="M4 10h16" />
          <path d="M4 14h10" />
          <path d="M4 18h10" />
          <path d="M18 14v6" />
          <path d="M15 17h6" />
        </svg>
      </span>
      <span class="settings-menu__text">
        <span class="settings-menu__label">Import HexaSmal</span>
        <span class="settings-menu__hint">Codes postaux ↔ INSEE</span>
      </span>
      <span class="settings-menu__chevron" aria-hidden="true">›</span>
    </a>

    <a
      href="/admin/dvf"
      class="settings-menu__item <%= adminSection === 'dvf' ? 'is-active' : '' %>"
      <%= adminSection === 'dvf' ? 'aria-current="page"' : '' %>
    >
      <span class="settings-menu__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 3v18h18" />
          <path d="M7 15l4-4 3 3 5-6" />
        </svg>
      </span>
      <span class="settings-menu__text">
        <span class="settings-menu__label">Import DVF</span>
        <span class="settings-menu__hint">Estimation du prix au m² (ventes réelles)</span>
      </span>
      <span class="settings-menu__chevron" aria-hidden="true">›</span>
    </a>

    <a
      href="/admin/adresse"
      class="settings-menu__item <%= adminSection === 'address-insight' ? 'is-active' : '' %>"
      <%= adminSection === 'address-insight' ? 'aria-current="page"' : '' %>
    >
      <span class="settings-menu__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 10c0 6-9 12-9 12s-9-6-9-12a9 9 0 0 1 18 0z" />
          <circle cx="12" cy="10" r="3" />
        </svg>
      </span>
      <span class="settings-menu__text">
        <span class="settings-menu__label">Infos adresse</span>
        <span class="settings-menu__hint">Prix au m², évolution, DPE</span>
      </span>
      <span class="settings-menu__chevron" aria-hidden="true">›</span>
    </a>

    <a
      href="/admin/amortissement"
      class="settings-menu__item <%= adminSection === 'amortization' ? 'is-active' : '' %>"
      <%= adminSection === 'amortization' ? 'aria-current="page"' : '' %>
    >
      <span class="settings-menu__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 3v18h18" />
          <path d="M7 14l3-3 3 2 5-6" />
          <path d="M17 7h3v3" />
        </svg>
      </span>
      <span class="settings-menu__text">
        <span class="settings-menu__label">Amortissement</span>
        <span class="settings-menu__hint">Tableau de crédit &amp; différé</span>
      </span>
      <span class="settings-menu__chevron" aria-hidden="true">›</span>
    </a>

    <a
      href="/admin/users"
      class="settings-menu__item <%= adminSection === 'users' ? 'is-active' : '' %>"
      <%= adminSection === 'users' ? 'aria-current="page"' : '' %>
    >
      <span class="settings-menu__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
          <circle cx="9" cy="7" r="4" />
          <path d="M22 21v-2a4 4 0 0 0-3-3.87" />
          <path d="M16 3.13a4 4 0 0 1 0 7.75" />
        </svg>
      </span>
      <span class="settings-menu__text">
        <span class="settings-menu__label">Utilisateurs</span>
        <span class="settings-menu__hint"><%= fmt.number(userCount) %> compte<%= userCount > 1 ? 's' : '' %></span>
      </span>
      <span class="settings-menu__chevron" aria-hidden="true">›</span>
    </a>

    <a
      href="/admin/enrichment-cache"
      class="settings-menu__item <%= adminSection === 'enrichment-cache' ? 'is-active' : '' %>"
      <%= adminSection === 'enrichment-cache' ? 'aria-current="page"' : '' %>
    >
      <span class="settings-menu__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <ellipse cx="12" cy="5" rx="9" ry="3" />
          <path d="M3 5v6c0 1.7 4 3 9 3s9-1.3 9-3V5" />
          <path d="M3 11v6c0 1.7 4 3 9 3s9-1.3 9-3v-6" />
        </svg>
      </span>
      <span class="settings-menu__text">
        <span class="settings-menu__label">Cache enrichissements</span>
        <span class="settings-menu__hint"><%= fmt.number(enrichmentCacheStats.commune + enrichmentCacheStats.listing) %> entrée<%= (enrichmentCacheStats.commune + enrichmentCacheStats.listing) > 1 ? 's' : '' %></span>
      </span>
      <span class="settings-menu__chevron" aria-hidden="true">›</span>
    </a>

    <a
      href="/admin/financing"
      class="settings-menu__item <%= adminSection === 'financing' ? 'is-active' : '' %>"
      <%= adminSection === 'financing' ? 'aria-current="page"' : '' %>
    >
      <span class="settings-menu__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <rect x="2" y="5" width="20" height="14" rx="2" />
          <path d="M2 10h20" />
        </svg>
      </span>
      <span class="settings-menu__text">
        <span class="settings-menu__label">Financement</span>
        <span class="settings-menu__hint">Taux forfaitaires</span>
      </span>
      <span class="settings-menu__chevron" aria-hidden="true">›</span>
    </a>

    <a
      href="/admin/visite"
      class="settings-menu__item <%= adminSection === 'visit-questions' ? 'is-active' : '' %>"
      <%= adminSection === 'visit-questions' ? 'aria-current="page"' : '' %>
    >
      <span class="settings-menu__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <rect width="8" height="4" x="8" y="2" rx="1" ry="1" />
          <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2" />
          <path d="m9 14 2 2 4-4" />
        </svg>
      </span>
      <span class="settings-menu__text">
        <span class="settings-menu__label">Questions de visite</span>
        <span class="settings-menu__hint">Éditer, classer, ajouter</span>
      </span>
      <span class="settings-menu__chevron" aria-hidden="true">›</span>
    </a>

    <a href="/admin/design-system" class="settings-menu__item">
      <span class="settings-menu__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="13.5" cy="6.5" r="1.5" />
          <circle cx="17.5" cy="10.5" r="1.5" />
          <circle cx="8.5" cy="7.5" r="1.5" />
          <circle cx="6.5" cy="12.5" r="1.5" />
          <path d="M12 2a10 10 0 0 0 0 20c1.1 0 2-.9 2-2 0-.5-.2-1-.5-1.3-.3-.4-.5-.8-.5-1.3 0-1.1.9-2 2-2h2.4A5.6 5.6 0 0 0 22 9.8C22 5.5 17.5 2 12 2z" />
        </svg>
      </span>
      <span class="settings-menu__text">
        <span class="settings-menu__label">Design system</span>
        <span class="settings-menu__hint">Couleurs, composants, règles UX</span>
      </span>
      <span class="settings-menu__chevron" aria-hidden="true">›</span>
    </a>
  </nav>
</aside>

<%
  // Positionnement du prix : lecture « en un coup d'œil » (verdict, trois
  // repères chiffrés, jauge à deux curseurs, référence en puces).
  // Re-rendable seul (OOB) quand le budget travaux change : `hxSwapOob`.
  const pp = position;
  const ref = pp.primary;
  const ww = ref.with_works || null;
  const oob = typeof hxSwapOob !== 'undefined' && hxSwapOob;
  const modalId =
    typeof dvfModalId !== 'undefined' && dvfModalId ? dvfModalId : 'immodata-dvf-sales-modal';
  const radiusInput = typeof dvfRadius !== 'undefined' ? dvfRadius : null;

  const eur = function (v) {
    if (v == null || !isFinite(v)) return '—';
    return fmt.euro(v);
  };
  const pct1 = function (v) {
    return (Math.round(Math.abs(v) * 10) / 10).toLocaleString('fr-FR') + '\u00a0%';
  };
  const signedPct = function (v) {
    if (v == null || !isFinite(v)) return '—';
    if (Math.round(v * 10) === 0) return '0\u00a0%';
    return (v < 0 ? '−\u00a0' : '+\u00a0') + pct1(v);
  };
  // Échelle de la jauge : 100 (prix du marché) au centre, bornée à 50–150.
  // Les curseurs restent visibles en bout de piste (1–99 %) au-delà de ±50 %.
  const gaugePos = function (index) {
    if (index == null || !isFinite(index)) return null;
    return Math.max(1, Math.min(99, index - 50));
  };
  const indexOfM2 = function (m2) {
    if (m2 == null || !ref.price_m2) return null;
    return (m2 / ref.price_m2) * 100;
  };
  const deltaTone = function (deltaPct) {
    if (deltaPct == null || !isFinite(deltaPct)) return 'near';
    if (deltaPct <= -2.5) return 'below';
    if (deltaPct >= 2.5) return 'above';
    return 'near';
  };
  const toneColor = function (tone) {
    if (tone === 'ok') return 'var(--green-600)';
    if (tone === 'high') return 'var(--danger-vivid)';
    if (tone === 'mid') return '#c98a00';
    return 'var(--ink-muted)';
  };

  const radiusRef = pp.references.find(function (r) { return r.key === 'radius'; });
  const radiusDetail =
    radiusRef && radiusRef.adjusted_radius ? radiusRef.adjusted_radius : radiusInput;
  const otherRefs = pp.references.filter(function (r) { return !r.primary; });

  const bandP25 = ref.p25_price_m2 != null ? gaugePos(indexOfM2(ref.p25_price_m2)) : null;
  const bandP75 = ref.p75_price_m2 != null ? gaugePos(indexOfM2(ref.p75_price_m2)) : null;
  const hasBand = bandP25 != null && bandP75 != null && bandP75 > bandP25;

  const surfaceComp = radiusRef && radiusRef.surface_comparable;
  const adj = ref.adjustment || null;
  const adjTooltip = adj
    ? 'Évolution des prix à ' + adj.label + ' : ' +
      adj.year_factors.map(function (f) { return f.year + ' ' + signedPct(f.pct); }).join(' · ')
    : null;
  const marketScopeLabel = ref.key === 'radius'
    ? 'Autour de l\'adresse · ' + fmt.number(ref.meters) + ' m'
    : ref.scope_label;

  const PRICE_GRADE_LETTERS = ['A', 'B', 'C', 'D', 'E', 'F'];
  const PRICE_GRADE_COLORS = ['#319834', '#5faa32', '#a7c62c', '#f2d307', '#eca40c', '#e2691b'];
  const priceGradeIdx = ref.grade
    ? PRICE_GRADE_LETTERS.indexOf(String(ref.grade).toUpperCase())
    : -1;
  // Le prix affiché, pas le prix travaux compris. « Légèrement sous le marché »
  // est l'écart typique d'un bien avant travaux : on le précise pour ne pas le
  // lire comme une affaire une fois les travaux ajoutés.
  const askingPriceLabel = function (text) {
    return text === "Légèrement sous le marché"
      ? "Légèrement sous le marché avant travaux"
      : text;
  };
  const titleLabel = askingPriceLabel(ref.label);
  const gradeLabel = askingPriceLabel(ref.grade_label);
%>
<div
  class="pricepos pricepos--<%= ref.tone %>"
  id="listing-price-position"
  <% if (oob) { %>hx-swap-oob="true"<% } %>
  <% if (ww) { %>style="--tone-works: <%= toneColor(ww.tone) %>"<% } %>
>
  <div class="pricepos__head">
    <div class="pricepos__intro">
      <p class="pricepos__eyebrow">Positionnement du prix</p>
      <h3 class="pricepos__title"><%= titleLabel %></h3>
      <div class="pricepos__scope">
        <span class="pricepos__scope-text">
          Référence : <strong><%= marketScopeLabel %></strong><% if (ref.period && ref.key !== 'radius') { %> · <%= ref.period %><% } %>
        </span>
        <details class="pricem2__dvf-method pricepos__help">
          <summary class="pricem2__dvf-method-trigger" aria-label="Comment est calculée l'estimation ?">
            <span class="pricem2__dvf-method-mark" aria-hidden="true">?</span>
          </summary>
          <div class="pricem2__dvf-method-panel">
            <p class="pricem2__dvf-method-title">Comment est calculée l'estimation ?</p>
            <p class="pricem2__dvf-method-lead">
              Prix au m² du bien comparé aux <strong><%= ref.basis_compare || ref.basis %></strong>.
              L'indice vaut 100 quand le bien est au prix du marché ; sous 100, il est moins cher.
              La note A–F reprend le même indice (A = excellente affaire, F = prix élevé).
            </p>
            <ul class="pricem2__dvf-method-list">
              <% if (ref.key === 'radius' || ref.key === 'quartier') { %>
                <% if (ref.address) { %>
                  <li>Adresse : <%= ref.address %><% if (ref.address_source) { %> (<%= ref.address_source %>)<% } %></li>
                <% } %>
              <% } %>
              <% if (ref.key === 'radius') { %>
                <li>Ventes DVF sur les <%= ref.years %> dernières années<% if (ref.widened) { %>, rayon élargi faute de ventes suffisantes<% } %></li>
                <% if (surfaceComp && surfaceComp.surface_filtered) { %>
                  <li>Médiane des <%= fmt.number(surfaceComp.count_in_band) %> ventes de surface comparable (±<%= surfaceComp.tolerance_pct %> %, soit <%= fmt.number(surfaceComp.min) %>–<%= fmt.number(surfaceComp.max) %> m²)</li>
                <% } else if (surfaceComp) { %>
                  <li>Peu de ventes en surface comparable (±<%= surfaceComp.tolerance_pct %> %) : médiane sur toutes les surfaces du rayon</li>
                <% } %>
                <% if (adj) { %>
                  <li>Chaque vente est ramenée au marché de <%= adj.reference_period %> selon l'évolution des prix à <%= adj.label %></li>
                <% } %>
              <% } else { %>
                <li>Prix de marché<% if (ref.period) { %> · <%= ref.period %><% } %></li>
              <% } %>
              <% if (ww) { %>
                <li>« Prix + travaux » : prix affiché augmenté du montant <strong>Travaux</strong> du financement (<%= eur(pp.works) %>), comparé à la même estimation</li>
              <% } %>
              <% if (ref.estimate_p25 != null && ref.estimate_p75 != null && ref.estimate_p25 !== ref.estimate_p75) { %>
                <li>Fourchette P25–P75 des ventes : <%= eur(ref.estimate_p25) %> – <%= eur(ref.estimate_p75) %></li>
              <% } %>
            </ul>
          </div>
        </details>
      </div>
    </div>
    <div class="pricepos__grade"
      title="Indice <%= ref.index %> / 100 : prix au m² du bien ÷ prix de référence × 100. A = excellente affaire, F = prix élevé.">
      <% if (priceGradeIdx >= 0) { %>
        <div class="pricepos__grade-row">
          <p class="pricepos__grade-eyebrow">Attractivité du prix :</p>
          <div class="pricepos__grade-scale-col">
            <div class="dpe-scale pricepos__grade-scale" role="img"
              aria-label="Attractivité du prix : <%= ref.grade %>. <%= gradeLabel %>">
              <% PRICE_GRADE_LETTERS.forEach(function (letter, i) {
                const isOn = i === priceGradeIdx;
                const darkText = i >= 2 && i <= 4;
              %>
                <span class="dpe-seg<%= isOn ? ' is-active' : '' %><%= isOn && darkText ? ' is-active--dark' : '' %>"
                  style="background: <%= PRICE_GRADE_COLORS[i] %>"><%= isOn ? letter : '' %></span>
              <% }); %>
            </div>
          </div>
        </div>
        <p class="pricepos__grade-caption"><%= gradeLabel %></p>
      <% } %>
    </div>
  </div>

  <dl class="pricepos__kpis">
    <div class="pricepos__kpi">
      <dt>Prix affiché</dt>
      <dd>
        <span class="pricepos__kpi-row">
          <strong><%= eur(pp.listing_price) %></strong>
          <span class="pricepos__badge pricepos__badge--<%= deltaTone(ref.delta_pct) %>"
            title="Écart au prix du marché : <%= signedPct(ref.delta_pct) %>"><%= signedPct(ref.delta_pct) %></span>
        </span>
        <span class="pricepos__kpi-sub"><%= eur(pp.listing_price_m2) %>/m² · <%= fmt.number(pp.surface) %> m²</span>
      </dd>
    </div>

    <% if (ww) { %>
      <div class="pricepos__kpi pricepos__kpi--works">
        <dt>Prix + travaux</dt>
        <dd>
          <span class="pricepos__kpi-row">
            <strong><%= eur(ww.price) %></strong>
            <span class="pricepos__badge pricepos__badge--<%= deltaTone(ww.delta_pct) %>"
              title="Écart au prix du marché, travaux compris : <%= signedPct(ww.delta_pct) %>"><%= signedPct(ww.delta_pct) %></span>
          </span>
          <% var worksRangeTooltip = pp.works_range
            ? 'Fourchette du plan des pièces : ' + eur(pp.works_range.min) + ' – ' + eur(pp.works_range.max)
              + (pp.works_edited ? '\nMontant retenu du tableau de financement : ' + eur(pp.works) : '')
            : '';
          var worksRangeTipClass = pp.works_range && pp.works_edited ? ' pricepos__tip--wrap' : ''; %>
          <span class="pricepos__kpi-sub<%= worksRangeTipClass %>"
            <% if (worksRangeTooltip) { %>data-tooltip="<%= worksRangeTooltip %>" tabindex="0"<% } %>
          >dont <%= eur(pp.works) %> de travaux · <%= eur(ww.price_m2) %>/m²</span>
        </dd>
      </div>
    <% } else { %>
      <div class="pricepos__kpi pricepos__kpi--muted">
        <dt>Prix + travaux</dt>
        <dd>
          <span class="pricepos__kpi-row"><strong>—</strong></span>
          <span class="pricepos__kpi-sub">
            Chiffrez les travaux dans le <a href="#listing-works">dossier technique</a> ou le <a href="#financement">financement</a>.
          </span>
        </dd>
      </div>
    <% } %>

    <div class="pricepos__kpi">
      <dt>Estimation marché</dt>
      <dd>
        <span class="pricepos__kpi-row"><strong>≈ <%= eur(ref.estimate) %></strong></span>
        <span class="pricepos__kpi-sub">
          <%= eur(ref.price_m2) %>/m² × <%= fmt.number(pp.surface) %> m²<% if (ref.estimate_p25 != null && ref.estimate_p75 != null && ref.estimate_p25 !== ref.estimate_p75) { %> ·
            <span class="pricepos__kpi-range" data-tooltip="Fourchette P25–P75 des ventes de référence" tabindex="0"><%= eur(ref.estimate_p25) %> – <%= eur(ref.estimate_p75) %></span><% } %>
        </span>
      </dd>
    </div>
  </dl>

  <div class="pricepos__gauge">
    <div class="pricem2__gauge-bar pricepos__gauge-bar" role="img"
      aria-label="Prix affiché <%= eur(pp.listing_price_m2) %>/m²<% if (ww) { %>, prix travaux compris <%= eur(ww.price_m2) %>/m²<% } %>, estimation marché <%= eur(ref.price_m2) %>/m²">
      <% if (hasBand) { %>
        <span class="pricepos__band" style="left: <%= bandP25 %>%; width: <%= bandP75 - bandP25 %>%"
          data-tooltip="Ventes P25–P75 · <%= eur(ref.p25_price_m2) %> – <%= eur(ref.p75_price_m2) %>/m²" tabindex="0"
          aria-label="Fourchette des ventes, <%= eur(ref.p25_price_m2) %> à <%= eur(ref.p75_price_m2) %> par m²"></span>
      <% } %>
      <span class="pricem2__gauge-ref" style="left: 50%"
        data-tooltip="Estimation marché · <%= eur(ref.price_m2) %>/m²" tabindex="0"
        aria-label="Estimation marché, <%= eur(ref.price_m2) %> par m²"></span>
      <% if (ww && ww.index != null) { %>
        <span class="pricepos__marker-wrap" style="left: <%= gaugePos(ww.index) %>%"
          data-tooltip="Prix + travaux · <%= eur(ww.price_m2) %>/m² · indice <%= ww.index %>" tabindex="0"
          aria-label="Prix travaux compris, <%= eur(ww.price_m2) %> par m²">
          <span class="pricepos__marker--works" aria-hidden="true"></span>
        </span>
      <% } %>
      <% if (ref.index != null) { %>
        <span class="pricem2__gauge-marker pricepos__marker--price" style="left: <%= gaugePos(ref.index) %>%"
          data-tooltip="Prix affiché · <%= eur(pp.listing_price_m2) %>/m² · indice <%= ref.index %>" tabindex="0"
          aria-label="Prix affiché, <%= eur(pp.listing_price_m2) %> par m²"></span>
      <% } %>
    </div>
    <div class="pricepos__gauge-scale" aria-hidden="true">
      <span>−50 %</span><span>Prix du marché</span><span>+50 %</span>
    </div>
    <ul class="pricepos__legend" aria-label="Légende de la jauge">
      <li><span class="pricepos__legend-dot pricepos__legend-dot--price" aria-hidden="true"></span>Prix affiché</li>
      <% if (ww) { %>
        <li><span class="pricepos__legend-dot pricepos__legend-dot--works" aria-hidden="true"></span>Prix + travaux</li>
      <% } %>
      <li><span class="pricepos__legend-dot pricepos__legend-dot--ref" aria-hidden="true"></span>Estimation marché</li>
      <% if (hasBand) { %>
        <li><span class="pricepos__legend-dot pricepos__legend-dot--band" aria-hidden="true"></span>Ventes P25–P75</li>
      <% } %>
    </ul>
  </div>

  <div class="pricepos__refs">
    <ul class="pricepos__chips" aria-label="Détails de la référence retenue">
      <% if (ref.key === 'radius') { %>
        <% if (radiusDetail && radiusDetail.sales && radiusDetail.sales.length) { %>
          <li>
            <button type="button" class="pricepos__chip pricepos__chip--link"
              data-dvf-sales-open="<%= modalId %>" aria-haspopup="dialog" aria-controls="<%= modalId %>"
              title="Voir les ventes utilisées">
              <%= fmt.number(ref.count) %> vente<%= ref.count > 1 ? 's' : '' %> · rayon <%= fmt.number(ref.meters) %> m
              <span class="pricepos__chip-arrow" aria-hidden="true">↗</span>
            </button>
          </li>
        <% } else { %>
          <li class="pricepos__chip"><%= fmt.number(ref.count) %> vente<%= ref.count > 1 ? 's' : '' %> · rayon <%= fmt.number(ref.meters) %> m</li>
        <% } %>
        <li class="pricepos__chip" data-tooltip="Demandes de valeurs foncières (Etalab), <%= ref.years %> dernières années" tabindex="0">DVF · <%= ref.years %> ans</li>
        <% if (surfaceComp && surfaceComp.surface_filtered) { %>
          <li class="pricepos__chip pricepos__tip--wrap"
            data-tooltip="<%= fmt.number(surfaceComp.count_in_band) %> vente<%= surfaceComp.count_in_band > 1 ? 's' : '' %> entre <%= fmt.number(surfaceComp.min) %> et <%= fmt.number(surfaceComp.max) %> m²"
            tabindex="0">Surface comparable ±<%= surfaceComp.tolerance_pct %> %</li>
        <% } else if (surfaceComp) { %>
          <li class="pricepos__chip pricepos__chip--warn pricepos__tip--wrap"
            data-tooltip="Peu de ventes en surface comparable (±<%= surfaceComp.tolerance_pct %> %) : médiane sur toutes les surfaces du rayon"
            tabindex="0">Toutes surfaces</li>
        <% } %>
        <% if (adj) { %>
          <li class="pricepos__chip pricepos__tip--wrap" data-tooltip="<%= adjTooltip %>" tabindex="0">Corrigé marché <%= adj.reference_period %></li>
        <% } %>
        <% if (ref.widened) { %>
          <li class="pricepos__chip pricepos__chip--warn" data-tooltip="Rayon élargi faute de ventes suffisantes" tabindex="0">Rayon élargi</li>
        <% } %>
        <% if (!ref.reliable) { %>
          <li class="pricepos__chip pricepos__chip--warn" data-tooltip="Trop peu de ventes pour une référence fiable" tabindex="0">Échantillon faible</li>
        <% } %>
      <% } else { %>
        <li class="pricepos__chip"><%= ref.key === 'quartier' ? 'Grand quartier' : 'Commune entière' %></li>
        <% if (ref.period) { %><li class="pricepos__chip">Prix de marché · <%= ref.period %></li><% } %>
      <% } %>
    </ul>

    <% if (otherRefs.length) { %>
      <details class="pricepos__more">
        <summary class="pricepos__more-summary">
          <span class="pricepos__more-chevron" aria-hidden="true"></span>
          Autres références comparées
          <span class="pricepos__more-count"><%= otherRefs.length %></span>
        </summary>
        <ul class="pricepos__more-list">
          <% otherRefs.forEach(function (r) { %>
            <li class="pricepos__more-item">
              <span class="pricepos__more-scope"><%= r.scope_label %></span>
              <span class="pricepos__more-meta">
                <% if (r.key === 'radius') { %>
                  <%= fmt.number(r.count) %> vente<%= r.count > 1 ? 's' : '' %><% if (!r.reliable) { %> · <em>échantillon faible</em><% } %>
                <% } else { %>
                  <%= eur(r.price_m2) %>/m²<% if (r.period) { %> · <%= r.period %><% } %>
                <% } %>
                · estimation ≈ <%= eur(r.estimate) %>
              </span>
              <% if (r.index != null) { %>
                <span class="pricepos__more-index" style="color: <%= toneColor(r.tone) %>"
                  title="<%= askingPriceLabel(r.label) %>"><%= r.index %><small>/100</small></span>
              <% } %>
            </li>
          <% }); %>
        </ul>
      </details>
    <% } %>

    <% if (!pp.has_address) { %>
      <p class="pricepos__hint">
        Estimation à l'échelle de la commune.
        <a href="#listing-location" data-listing-address-open-from-hint>Renseignez l'adresse</a> pour la comparer aux ventes autour du bien.
      </p>
    <% } else if (!radiusRef) { %>
      <p class="pricepos__hint">
        Ventes autour de l'adresse pas encore disponibles : la commune sert de référence en attendant.
      </p>
    <% } else if (!radiusRef.reliable && ref.key !== 'radius') { %>
      <p class="pricepos__hint">
        Trop peu de ventes autour de l'adresse (<%= fmt.number(radiusRef.count) %>) : référence « <%= ref.scope_label %> » retenue.
      </p>
    <% } %>
  </div>
</div>

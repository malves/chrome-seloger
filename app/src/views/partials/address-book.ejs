<%
  // Corps du panneau « Carnet d'adresses », extrait en partial pour être
  // re-rendu et échangé par htmx sans recharger toute la page Paramètres.
  // Variables attendues : addresses, travelEnabled, csrfToken (res.locals) et,
  // en option, addressFlash ({ type, message }) pour un retour inline.
  var flash = typeof addressFlash !== "undefined" ? addressFlash : null;
%>
<div
  id="address-book"
  class="address-book"
  hx-target="#address-book"
  hx-swap="outerHTML"
  hx-indicator=".address-book__overlay"
  hx-disabled-elt="find button"
>
  <!-- Voile de chargement : bloque les interactions et affiche le spinner
       pendant le géocodage (requête parfois longue). -->
  <div class="address-book__overlay" aria-hidden="true">
    <span class="spinner" role="status" aria-label="Chargement…"></span>
  </div>

  <% if (flash) { %>
    <div
      class="flash flash--<%= flash.type || 'info' %> address-book__flash"
      role="status"
      data-address-flash
    >
      <%= flash.message %>
    </div>
  <% } %>

  <% if (!travelEnabled) { %>
    <p class="form-errors" role="status" style="margin-bottom: var(--space-4)">
      Le calcul d'itinéraire est actuellement indisponible côté serveur
      (clé OpenRouteService non configurée). Les adresses sont enregistrées
      et seront géocodées au prochain calcul.
    </p>
  <% } %>

  <div class="address-book__add" aria-labelledby="address-book-add-title">
    <h3 class="address-book__add-title" id="address-book-add-title">
      Ajouter une adresse au carnet
    </h3>

    <form class="address-book__add-form" hx-post="/settings/addresses">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

      <div class="field address-book__add-field address-book__add-field--label">
        <label class="field__label" for="new_label">Libellé</label>
        <input
          class="input input--sm"
          type="text"
          id="new_label"
          name="label"
          maxlength="40"
          placeholder="Bureau, École…"
          autocomplete="off"
        />
      </div>

      <div class="field address-book__add-field address-book__add-field--address">
        <label class="field__label" for="new_address">Adresse</label>
        <input
          class="input input--sm"
          type="text"
          id="new_address"
          name="address"
          maxlength="200"
          placeholder="12 rue de Rivoli, 75001 Paris"
          autocomplete="off"
          required
        />
      </div>

      <button class="btn btn--green btn--sm address-book__add-submit" type="submit">
        <span class="btn__spinner" aria-hidden="true"></span>
        <span class="btn__label">Ajouter</span>
      </button>
    </form>
  </div>

  <div class="address-book__list" style="margin-top: var(--space-5)">
    <h3 class="address-book__list-title">
      Adresses enregistrées
      <span class="address-book__list-count">
        (<%= addresses.length %>)
      </span>
    </h3>

    <% if (!addresses.length) { %>
      <p class="field__hint">
        Aucune adresse pour l'instant. Utilisez le formulaire ci-dessus pour
        en ajouter une, ou saisissez-en une depuis un projet : elle
        rejoindra automatiquement ce carnet.
      </p>
    <% } else { %>
      <ul class="address-list">
        <% addresses.forEach(function (addr) { %>
          <li class="address-list__item address-book__item">
            <div class="address-book__main">
              <div class="address-book__line" data-rename>
                <span
                  class="address-book__name<%= addr.label ? '' : ' is-empty' %>"
                  data-rename-label
                  data-rename-value="<%= addr.label || '' %>"
                >
                  <%= addr.label || 'Sans libellé' %>
                </span>
                <button
                  type="button"
                  class="project-rename"
                  data-rename-open
                  data-tooltip="Modifier"
                  aria-label="Renommer le libellé « <%= addr.label || 'Sans libellé' %> »"
                >
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 20h9" />
                    <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z" />
                  </svg>
                </button>
                <form
                  class="project-rename-form"
                  method="post"
                  action="/settings/addresses/<%= addr.id %>"
                  hx-post="/settings/addresses/<%= addr.id %>"
                  hidden
                  data-rename-form
                >
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                  <input type="hidden" name="address" value="<%= addr.address %>" />
                  <input
                    class="input input--sm project-rename__input"
                    type="text"
                    name="label"
                    value="<%= addr.label || '' %>"
                    maxlength="40"
                    placeholder="Libellé (Bureau, École…)"
                    autocomplete="off"
                    aria-label="Libellé de l'adresse"
                    data-rename-input
                    data-rename-allow-empty="1"
                  />
                </form>
              </div>

              <div class="address-book__line" data-rename>
                <span class="address-book__address" data-rename-label>
                  <%= addr.address %>
                </span>
                <button
                  type="button"
                  class="project-rename"
                  data-rename-open
                  data-tooltip="Modifier"
                  aria-label="Modifier l'adresse « <%= addr.address %> »"
                >
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 20h9" />
                    <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z" />
                  </svg>
                </button>
                <form
                  class="project-rename-form"
                  method="post"
                  action="/settings/addresses/<%= addr.id %>"
                  hx-post="/settings/addresses/<%= addr.id %>"
                  hidden
                  data-rename-form
                >
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                  <input type="hidden" name="label" value="<%= addr.label || '' %>" />
                  <input
                    class="input input--sm project-rename__input address-book__rename-input"
                    type="text"
                    name="address"
                    value="<%= addr.address %>"
                    maxlength="200"
                    placeholder="12 rue de Rivoli, 75001 Paris"
                    autocomplete="off"
                    required
                    aria-label="Adresse"
                    data-rename-input
                  />
                </form>
              </div>

              <div class="address-book__meta">
                <% if (addr.lat != null && addr.lng != null) { %>
                  <span class="badge badge--accent">Localisée</span>
                <% } else { %>
                  <span class="badge badge--warn">À géocoder</span>
                <% } %>
                <%
                  var mapsQuery = (addr.lat != null && addr.lng != null)
                    ? addr.lat + "," + addr.lng
                    : addr.address;
                %>
                <a
                  class="address-book__map"
                  href="https://www.google.com/maps/search/?api=1&amp;query=<%= encodeURIComponent(mapsQuery) %>"
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="Voir « <%= addr.label || addr.address %> » dans Google Maps"
                >Carte</a>
                <span class="card__foot-note">
                  <% if (addr.project_count === 0) { %>
                    Cette adresse n'est utilisée dans aucun projet.
                  <% } else if (addr.project_count === 1) { %>
                    Cette adresse est utilisée dans 1 projet.
                  <% } else { %>
                    Cette adresse est utilisée dans <%= addr.project_count %> projets.
                  <% } %>
                </span>
                <form
                  class="address-book__delete-form"
                  method="post"
                  action="/settings/addresses/<%= addr.id %>/delete"
                  hx-post="/settings/addresses/<%= addr.id %>/delete"
                  data-confirm="Supprimer « <%= addr.label || addr.address %> » du carnet ? Elle sera retirée de tous les projets qui l'utilisent."
                >
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                  <button
                    class="btn btn--ghost btn--sm btn--danger-ghost"
                    type="submit"
                  >
                    Supprimer
                  </button>
                </form>
              </div>
            </div>
          </li>
        <% }); %>
      </ul>
    <% } %>
  </div>
</div>

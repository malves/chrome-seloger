<%
  const marketHasData = otherProviders.some(function (p) {
    return p.status === "ok" && p.data;
  });
  const marketFetchedAt = otherProviders.reduce(function (latest, provider) {
    if (!provider.fetchedAt) return latest;
    if (!latest || provider.fetchedAt > latest) return provider.fetchedAt;
    return latest;
  }, null);
  const adminCanRefresh =
    listing && listing.id && typeof isAdmin !== "undefined" && isAdmin;
  const showMarketHeadAside = marketFetchedAt || adminCanRefresh;
%>
<section class="panel listing-market" id="listing-market" data-toc-label="Prix de marché">
  <div class="address-book__overlay listing-market__overlay" aria-hidden="true">
    <span class="spinner" role="status" aria-label="Chargement…"></span>
  </div>

  <div class="panel__head">
    <div>
      <p class="panel__eyebrow">Enrichissement marché</p>
      <h2 class="panel__title">Prix de marché</h2>
    </div>
    <% if (showMarketHeadAside) { %>
      <div class="panel__head-aside">
        <% if (marketFetchedAt) { %>
          <span class="card__foot-note">
            Mise à jour <%= fmt.relative(marketFetchedAt) %>
          </span>
        <% } %>
        <% if (adminCanRefresh) { %>
          <form
            class="listing-market__refresh"
            hx-post="/listings/<%= listing.id %>/enrich/marche"
            hx-target="#listing-market"
            hx-swap="outerHTML"
            hx-indicator="#listing-market .listing-market__overlay"
            hx-disabled-elt="find button"
          >
            <button class="btn btn--ghost btn--sm" type="submit">
              <%= marketHasData ? "Actualiser" : "Réessayer" %>
            </button>
          </form>
        <% } %>
      </div>
    <% } %>
  </div>

  <div class="listing-market__body">
    <% otherProviders.forEach(function (provider) { %>
      <%- include("enrichment-block", {
        provider: provider,
        listing: listing,
        hideProviderRefresh: true,
        hideProviderHead: true,
        hideProviderAside: true
      }) %>
    <% }); %>
  </div>
</section>

<%- include("listing-location-block", { listing: listing, userAddressMapsHref: userAddressMapsHref }) %>
<% if (typeof photos !== "undefined" && photos && photos.length) { %>
<%- include("listing-works-dpe-template", {
  linkedDpeInsights: typeof linkedDpeInsights !== "undefined" ? linkedDpeInsights : null,
  hxSwapOob: true,
}) %>
<% } %>
<% if (typeof photos !== "undefined" && photos && photos.length && typeof photoAnalysis !== "undefined" && photoAnalysis) { %>
<%- include("listing-photo-analysis", {
  listing: listing,
  photos: photos,
  photoAnalysis: photoAnalysis,
  photoLabels: photoLabels,
  worksHasPhotos: photos.length > 0,
  refreshWorksHeadAside: true,
  hxSwapOob: true,
}) %>
<% } %>

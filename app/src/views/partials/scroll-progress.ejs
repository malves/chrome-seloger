<%#
  Bouton « Revenir en haut » dont l'anneau suit la progression du défilement
  (pattern nav-scroll-progress). Piloté par app.js ([data-scroll-progress]) ;
  nécessite le sprite partials/works-icons sur la page. `inline: true` le
  place dans le flux, toujours visible (spécimen du design system).
%>
<button type="button" class="scroll-progress<%= locals.inline ? ' scroll-progress--inline' : '' %>" data-scroll-progress aria-label="Revenir en haut de la page">
  <svg class="scroll-progress__ring" viewBox="0 0 46 46" aria-hidden="true">
    <circle class="scroll-progress__track" cx="23" cy="23" r="21.5" />
    <circle class="scroll-progress__fill" cx="23" cy="23" r="21.5" pathLength="100" data-scroll-progress-fill />
  </svg>
  <svg class="wi scroll-progress__icon" aria-hidden="true"><use href="#wi-arrow-up"></use></svg>
</button>

<div
  id="listing-location-block"
  class="listing-location-block"
  hx-target="#listing-location-block"
  hx-swap="outerHTML"
  hx-indicator="find .listing-location__overlay"
  hx-disabled-elt="find button, find input"
>
  <%- include("listing-location", { listing: listing }) %>
  <%- include("listing-linked-dpe", { linkedDpeInsights: typeof linkedDpeInsights !== 'undefined' ? linkedDpeInsights : null }) %>
  <%- include("listing-address-modal", { listing: listing }) %>
  <%- include("listing-address-ai-modal", { listing: listing }) %>
</div>

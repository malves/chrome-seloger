<header class="topbar">
  <% if (user) { %>
    <div class="topbar__scrim" data-mobile-nav-dismiss aria-hidden="true"></div>
  <% } %>
  <div class="topbar__inner">
    <% if (user) { %>
      <button
        type="button"
        class="topbar__menu-btn"
        data-mobile-nav-toggle
        aria-expanded="false"
        aria-controls="main-topnav"
      >
        <span class="topbar__menu-btn-bars" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </span>
        <span class="visually-hidden">Ouvrir le menu</span>
      </button>
    <% } %>

    <a class="brand" href="/">
      <span class="brand__mark" aria-hidden="true">C</span>
      <span class="brand__name">Carnet <span class="brand__de">de</span> Visites</span>
    </a>

    <% if (user) { %>
      <nav class="topnav" id="main-topnav" aria-label="Navigation principale">
        <div class="topnav__drawer-head">
          <p class="topnav__drawer-eyebrow">Connecté</p>
          <p class="topnav__drawer-email" title="<%= user.email %>"><%= user.email %></p>
        </div>

        <div class="topnav__drawer-links">
          <a
            class="topnav__link <%= currentPath.startsWith('/listings') ? 'is-active' : '' %>"
            href="/listings"
          >
            <span class="topnav__link-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 9.5 12 4l9 5.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1V9.5Z" />
              </svg>
            </span>
            <span class="topnav__link-text">
              <span class="topnav__link-label">Annonces</span>
              <span class="topnav__link-hint">Biens enregistrés</span>
            </span>
            <span class="topnav__link-chevron" aria-hidden="true">›</span>
          </a>
          <a
            class="topnav__link <%= currentPath.startsWith('/projects') ? 'is-active' : '' %>"
            href="/projects"
          >
            <span class="topnav__link-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 7h16M4 12h10M4 17h16" />
                <circle cx="18" cy="12" r="2.5" />
              </svg>
            </span>
            <span class="topnav__link-text">
              <span class="topnav__link-label">Gérer les projets</span>
              <span class="topnav__link-hint">Dossiers et classement</span>
            </span>
            <span class="topnav__link-chevron" aria-hidden="true">›</span>
          </a>
          <a
            class="topnav__link <%= currentPath.startsWith('/settings') ? 'is-active' : '' %>"
            href="/settings"
          >
            <span class="topnav__link-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="3" />
                <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
              </svg>
            </span>
            <span class="topnav__link-text">
              <span class="topnav__link-label">Paramètres</span>
              <span class="topnav__link-hint">Compte et extension</span>
            </span>
            <span class="topnav__link-chevron" aria-hidden="true">›</span>
          </a>
          <% if (isAdmin) { %>
            <a
              class="topnav__link <%= currentPath.startsWith('/admin') ? 'is-active' : '' %>"
              href="/admin"
            >
              <span class="topnav__link-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 3 4 7v6c0 5 3.5 8.7 8 10 4.5-1.3 8-5 8-10V7l-8-4Z" />
                  <path d="m9 12 2 2 4-4" />
                </svg>
              </span>
              <span class="topnav__link-text">
                <span class="topnav__link-label">Admin</span>
                <span class="topnav__link-hint">Données et imports</span>
              </span>
              <span class="topnav__link-chevron" aria-hidden="true">›</span>
            </a>
          <% } %>
        </div>

        <div class="topnav__drawer-foot">
          <form method="post" action="/logout">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <button class="btn btn--ghost btn--block topnav__logout" type="submit">Déconnexion</button>
          </form>
        </div>
      </nav>

      <div class="topbar__account topbar__account--header">
        <span class="topbar__email" title="<%= user.email %>"><%= user.email %></span>
        <form method="post" action="/logout">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <button class="btn btn--ghost btn--sm" type="submit">Déconnexion</button>
        </form>
      </div>
    <% } else { %>
      <div class="topbar__account">
        <a class="btn btn--ghost btn--sm" href="/login">Connexion</a>
        <a class="btn btn--dark btn--sm" href="/signup">Créer un compte</a>
      </div>
    <% } %>
  </div>
</header>

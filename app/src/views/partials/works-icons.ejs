<%#
  Sprite d'icônes du site : <svg class="wi"><use href="#wi-NOM" /></svg>.
  Tracés dans `lib/icons.js` (exposés en `iconSprite` par app.js).
%>
<svg class="wi-sprite" aria-hidden="true" focusable="false" width="0" height="0" style="position:absolute;width:0;height:0;overflow:hidden">
  <% Object.keys(iconSprite).forEach(function (name) { %>
    <symbol id="wi-<%= name %>" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><%- iconSprite[name] %></symbol>
  <% }); %>
</svg>

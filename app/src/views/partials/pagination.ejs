<%
  // Pagination serveur : chaque numéro est un lien vers la même liste avec
  // `page` modifié, donc la navigation fonctionne sans JavaScript.
  const { page, pageCount, from, to, total } = pagination;

  // La page 1 est l'URL « propre » (sans paramètre `page`).
  function pageUrl(n) {
    return fmt.listingsUrl(query, { page: n === 1 ? null : n });
  }

  // Fenêtre compacte : première et dernière page, plus les voisines de la page
  // courante. Les trous sont marqués d'une ellipse.
  const items = [];
  const around = 1;
  for (let n = 1; n <= pageCount; n++) {
    if (n === 1 || n === pageCount || (n >= page - around && n <= page + around)) {
      items.push(n);
    } else if (items[items.length - 1] !== "gap") {
      items.push("gap");
    }
  }

  const hasPrev = page > 1;
  const hasNext = page < pageCount;
%>

<% if (total > 0) { %>
<%# Affichée dès qu'il y a au moins une annonce dans le résultat filtré. %>
  <nav class="pagination" aria-label="Pagination des annonces">
    <p class="pagination__summary">
      <%= from %>–<%= to %> sur <%= total %> annonce<%= total > 1 ? "s" : "" %>
    </p>

    <ul class="pagination__list">
      <li>
        <% if (hasPrev) { %>
          <a class="pagination__nav" href="<%= pageUrl(page - 1) %>" rel="prev" aria-label="Page précédente">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m15 18-6-6 6-6" />
            </svg>
            <span>Précédent</span>
          </a>
        <% } else { %>
          <span class="pagination__nav is-disabled" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m15 18-6-6 6-6" />
            </svg>
            <span>Précédent</span>
          </span>
        <% } %>
      </li>

      <% items.forEach(function (item) { %>
        <li>
          <% if (item === "gap") { %>
            <span class="pagination__gap" aria-hidden="true">…</span>
          <% } else if (item === page) { %>
            <a class="pagination__page is-active" href="<%= pageUrl(item) %>" aria-current="page" aria-label="Page <%= item %>">
              <%= item %>
            </a>
          <% } else { %>
            <a class="pagination__page" href="<%= pageUrl(item) %>" aria-label="Page <%= item %>">
              <%= item %>
            </a>
          <% } %>
        </li>
      <% }); %>

      <li>
        <% if (hasNext) { %>
          <a class="pagination__nav" href="<%= pageUrl(page + 1) %>" rel="next" aria-label="Page suivante">
            <span>Suivant</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m9 18 6-6-6-6" />
            </svg>
          </a>
        <% } else { %>
          <span class="pagination__nav is-disabled" aria-hidden="true">
            <span>Suivant</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m9 18 6-6-6-6" />
            </svg>
          </span>
        <% } %>
      </li>
    </ul>
  </nav>
<% } %>

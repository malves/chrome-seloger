<%
  // Un bloc par provider : titre, contenu délégué au partial du provider,
  // état d'erreur commun avec bouton « Réessayer ».
%>
<%
  // Pour le bloc communal, le titre reprend le nom de la commune (évite de
  // répéter « Commune » en titre puis en ligne de détail). Fallback « Commune »
  // si la donnée n'est pas encore disponible.
  const communeName =
    provider.scope === "commune" && provider.data ? provider.data.name : null;
  const resolvedTitle = communeName
    ? communeName
    : typeof sectionTitle !== "undefined"
      ? sectionTitle
      : provider.scope === "commune"
        ? "Commune"
        : null;
  const resolvedEyebrow =
    typeof eyebrow !== "undefined"
      ? eyebrow
      : resolvedTitle
        ? "Territoire"
        : null;
  const hideRefresh =
    typeof hideProviderRefresh !== "undefined" && hideProviderRefresh;
  const showTerritoryRefresh =
    typeof territoryRefresh !== "undefined" && territoryRefresh;
  const territoryRefreshLabel =
    typeof territoryHasData !== "undefined" && territoryHasData
      ? "Actualiser"
      : "Réessayer";
%>
<div class="provider-block" id="provider-<%= provider.key %>">
  <div class="panel__head">
    <% if (resolvedTitle) { %>
      <div>
        <% if (resolvedEyebrow) { %>
          <p class="panel__eyebrow"><%= resolvedEyebrow %></p>
        <% } %>
        <h2 class="panel__title"><%= resolvedTitle %></h2>
      </div>
    <% } else { %>
      <h3 class="panel__title"><%= provider.label %></h3>
    <% } %>
    <div class="panel__head-aside">
      <% if (provider.fetchedAt) { %>
        <span class="card__foot-note">
          Mise à jour <%= fmt.relative(provider.fetchedAt) %>
        </span>
      <% } %>
      <% if (showTerritoryRefresh) { %>
        <form
          class="listing-territory__refresh"
          hx-post="/listings/<%= listing.id %>/enrich/territoire"
          hx-target="#listing-territory"
          hx-swap="outerHTML"
          hx-indicator="#listing-territory .listing-territory__overlay"
          hx-disabled-elt="find button"
        >
          <button class="btn btn--ghost btn--sm" type="submit">
            <%= territoryRefreshLabel %>
          </button>
        </form>
      <% } %>
      <% if (!hideRefresh) { %>
        <form
          hx-post="/listings/<%= listing.id %>/enrich/<%= provider.key %>"
          hx-target="#provider-<%= provider.key %>"
          hx-swap="outerHTML"
        >
          <button class="btn btn--ghost btn--sm" type="submit">
            <%= provider.status === 'ok' ? 'Actualiser' : 'Réessayer' %>
          </button>
        </form>
      <% } %>
    </div>
  </div>

  <% if (provider.status === 'ok' && provider.data) { %>
    <%- include(provider.partial, { data: provider.data, listing: listing, provider: provider }) %>
  <% } else if (provider.status === 'pending') { %>
    <p class="field__hint">Donnée en cours de récupération…</p>
  <% } else { %>
    <p class="field__hint">
      Donnée indisponible.
      <% if (provider.error) { %>
        <span class="field-error"><%= provider.error %></span>
      <% } %>
    </p>
  <% } %>

  <%
    const sourceInDelinquancePartial =
      provider.key === 'delinquance' &&
      provider.status === 'ok' &&
      provider.data &&
      provider.data.indicators &&
      provider.data.indicators.length;
  %>
  <% if (provider.source && !sourceInDelinquancePartial) { %>
    <p class="provider-source">
      Source :
      <% if (provider.sourceUrl) { %>
        <a href="<%= provider.sourceUrl %>" target="_blank" rel="noreferrer noopener"><%= provider.source %></a>
      <% } else { %>
        <%= provider.source %>
      <% } %>
    </p>
  <% } %>
</div>

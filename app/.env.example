NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000
# Production (carnetdevisites.fr) : BASE_URL=https://carnetdevisites.fr
DATABASE_PATH=./data/app.db
SESSION_SECRET=change-me
# Comptes autorisés sur /admin (e-mails enregistrés en base). Liste séparée par
# des virgules, ou un seul e-mail via ADMIN_EMAIL.
ADMIN_EMAILS=contact@example.com
# Origines de l'extension autorisées sur /api/v1/*. Restreint aussi les
# extensions qui peuvent recevoir un code d'autorisation : à renseigner en
# production. Vide = toute extension Chrome (pratique en développement).
EXTENSION_ORIGINS=chrome-extension://<id-de-l-extension>

# Version minimale de l'extension (x.y.z). Vide = pas de blocage. Les clients
# plus anciens reçoivent HTTP 426 extension_outdated.
EXTENSION_MIN_VERSION=

# Clé OpenRouteService partagée : le temps de trajet est calculé côté serveur,
# la même clé sert à tous les navigateurs connectés. Clé gratuite sur
# https://openrouteservice.org/dev/#/signup (vide = calcul d'itinéraire désactivé).
ORS_API_KEY=

# Google Maps (metadata Street View uniquement, sans quota). Si renseignée, les liens
# « Google Maps » ouvrent Street View seulement lorsqu'une prise de vue existe ;
# sinon recherche classique (évite l'écran noir). Clé : console Google Cloud,
# activer « Street View Static API » (les requêtes metadata sont gratuites).
# GOOGLE_MAPS_API_KEY=

# Import SSMSI (délinquance) : URLs des fichiers data.gouv (optionnel, défaut juillet 2026).
# SSMSI_COMMUNE_URL=
# SSMSI_DEP_URL=

# Jeton Bearer Immo Data (2e analyse de marché). Sans le préfixe « Bearer ».
# https://developer.immo-data.fr
IMMO_DATA_API_KEY=
# IMMO_DATA_BASE_URL=https://api.immo-data.fr
# IMMO_DATA_CACHE_TTL_DAYS=25

# Fond de carte (fiche annonce, Leaflet). Sans clé : repli Esri World Street Map.
# Avec une clé gratuite CARTO Voyager (style OSM), carte plus fine, sans quota serré :
# https://carto.com/basemaps/apikey
CARTO_BASEMAP_KEY=

# Moteur de localisation probable — LLM (extraction de contraintes de l'annonce).
# Client compatible OpenAI : fonctionne avec OpenAI, Mistral, Groq, OpenRouter,
# Ollama local... Vide = extraction désactivée (le moteur répond "unavailable").
LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_TIMEOUT_MS=20000

# Analyse des photos d'annonce (vision). Par défaut : même clé et même URL que
# le LLM ci-dessus, modèle gpt-4o-mini, images en détail « high ».
# VISION_API_KEY=
# VISION_BASE_URL=https://api.openai.com/v1
# VISION_MODEL=gpt-4o-mini
# VISION_IMAGE_DETAIL=high
# Détail des images envoyées à la synthèse (low = moins cher, mais défauts fins invisibles)
# VISION_SYNTHESIS_DETAIL=high
# VISION_TIMEOUT_MS=90000
# VISION_MAX_PHOTOS=30
# VISION_BATCH_SIZE=8
# Seconde lecture des images non classées (0 = désactivée)
# VISION_RETRY_BATCH_SIZE=2
# VISION_MAX_RETRY_IMAGES=12

# Moteur de localisation probable — Nominatim (géocodage des lieux/POI).
# Nominatim demande un User-Agent/email identifiant et limite à ~1 req/s.
# NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_EMAIL=
# NOMINATIM_USER_AGENT=CarnetDeVisites/1.0 (+https://votre-domaine)
# NOMINATIM_TIMEOUT_MS=8000

# Moteur de localisation probable — réglages (tous optionnels, voir config.js).
# Finesse de la grille, courbes de tolérance, poids des contraintes, seuil
# d'incohérence... Les isochrones réutilisent ORS_API_KEY (repli cercle sinon).
# PLOC_GRID_SIZE=60
# PLOC_CONSISTENCY_THRESHOLD=0.35

# Journalisation : trace | debug | info | warn | error | silent
LOG_LEVEL=info
